2320   0900             ;*****************************************************************************
2321   0900             L0900:
2322   0900 3A A0 43                           LD      A,(IN0Current)      ;
2323   0903 2F                                 CPL                         ; flip the current bits
2324   0904 E6 60                              AND     $60                 ; mask out 0110_0000
2325   0906 C8                                 RET     Z                   ; if no button pressed
2326   0907 E6 40                              AND     $40                 ; mask out 0100_0000
2327   0909 CA 17 09                           JP      Z,L0917             ;
2328   090C 7E                                 LD      A,(HL)              ; get $43C2 PlayerShipX
2329   090D FE 0D                              CP      $0D                 ;
2330   090F D8                                 RET     C                   ; if left boundary reached
2331   0910 35                                 DEC     (HL)                ; 'left' button: dec $43C2 PlayerShipX
2332   0911 3E FF                              LD      A,$FF               ;
2333   0913 32 60 43                           LD      (PlayerMoved),A     ; set 'player moved' flag
2334   0916 C9                                 RET                         ;
2335   0917             L0917:
2336   0917 7E                                 LD      A,(HL)              ; get $43C2 PlayerShipX
2337   0918 FE C0                              CP      $C0                 ;
2338   091A D0                                 RET     NC                  ; if right boundary reached
2339   091B 34                                 INC     (HL)                ; 'right' button: inc $43C2 PlayerShipX
2340   091C 3E FF                              LD      A,$FF               ;
2341   091E 32 60 43                           LD      (PlayerMoved),A     ; set 'player moved' flag
2342   0921 C9                                 RET                         ;
