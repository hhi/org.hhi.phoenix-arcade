2805   0BBA             ;*****************************************************************************
2806   0BBA             ;* Player-ship explosion:
2807   0BBA             ;* Per-frame visual dispatcher.
2808   0BBA             ;* Entered from L0AEA (game state 4) with A = CounterA5 (explosion phase),
2809   0BBA             ;* when CounterA5 >= $20. Selects one task per frame from the low 2 bits,
2810   0BBA             ;* so the three effects are interleaved as the counter runs down:
2811   0BBA             ;*   CounterA5 & 1 == 0   -> L0FC0  killed-alien animation upkeep
2812   0BBA             ;*   CounterA5 & 3 == 01  -> L20E8  draw a 4x4 ship-fragment sprite
2813   0BBA             ;*   CounterA5 & 3 == 11  -> L2070  render the particle field (T2800/T2900)
2814   0BBA             ;* So across consecutive frames the three low bit patterns rotate through the three tasks,
2815   0BBA             ;* letting the game advance the debris field, the fragment sprites,
2816   0BBA             ;* and any in progress killed alien effects without doing all of them in a single frame.
2817   0BBA             ;*****************************************************************************
2818   0BBA             L0BBA:
2819   0BBA 47                                 LD      B,A                 ;
2820   0BBB 0F                                 RRCA                        ;
2821   0BBC D2 C0 0F                           JP      NC,L0FC0            ; Handle animations for killed aliens
2822   0BBF 0F                                 RRCA                        ;
2823   0BC0 78                                 LD      A,B                 ;
2824   0BC1 DA 70 20                           JP      C,L2070             ;
2825   0BC4 C3 E8 20                           JP      L20E8               ;
2826   0BC7             
2827   0BCA                                    .ORG $0BCA
2828   0BCA             ;*****************************************************************************
2829   0BCA             ;* Draws the character tiles for the score average table.
2830   0BCA             ;*****************************************************************************
2831   0BCA             DrawScoreAverageTableTiles:
2832   0BCA 21 D0 42                           LD      HL,$42D0            ; upper left corner screen ram position
2833   0BCD 01 DF FF                           LD      BC,$FFDF            ; Screen offset constant -33 right one column (-1), up one row (-32)
2834   0BD0 36 64                              LD      (HL),$64            ; left part of alien shape #3
2835   0BD2 09                                 ADD     HL,BC               ;
2836   0BD3 23                                 INC     HL                  ;
2837   0BD4 36 65                              LD      (HL),$65            ; right part of alien shape #3
2838   0BD6 21 F2 42                           LD      HL,$42F2            ; screen ram position for
2839   0BD9 11 40 0A                           LD      DE,T0A40            ; T0A40 alien shape #37 and alien shape #34
2840   0BDC CD 38 35                           CALL    Draw4x2             ;
2841   0BDF 21 15 4B                           LD      HL,$4B15            ; screen ram position for
2842   0BE2 11 00 3C                           LD      DE,T3C00            ; bird shape #24 (Object 3C00)
2843   0BE5 CD 28 35                           CALL    Draw6x2             ;
2844   0BE8 21 D8 4A                           LD      HL,$4AD8            ; screen ram position for
2845   0BEB 11 48 0A                           LD      DE,T0A48            ; T0A48 alien pilot shape
2846   0BEE CD 48 35                           CALL    Draw2x2             ;
2847   0BF1 C9                                 RET                         ;
2848   0BF2             
2849   0C00                                    .ORG $0C00
2850   0C00             ;*****************************************************************************
2851   0C00             ;* Score/bonus selector for a shot flying alien:
2852   0C00             ;* A flying alien was hit. Choose its explosion / score from its current
2853   0C00             ;* movement-pattern phase.
2854   0C00             ;* Entry: HL -> struck alien's screen-X field ($4B72 + 4*index).
2855   0C00             ;* Per-alien movement-pattern pointers live at $4B50 (2 bytes: MSB,LSB each).
2856   0C00             ;* Pattern value 7 or 8 (attack/dive apex) -> 200-pt bonus + bonus explosion;
2857   0C00             ;* any other value -> normal kill.  All paths finish in L0EA4.
2858   0C00             ;* This routine is the mechanic that rewards shooting an alien at the peak of its swoop/dive,
2859   0C00             ;* only when the enemy's movement pattern is in phase 7–8 do you get the 200 point bonus
2860   0C00             ;* and the special bonus explosion, hitting it at any other point in its flight
2861   0C00             ;* gives the ordinary kill value.
2862   0C00             ;*****************************************************************************
2863   0C00             L0C00:
2864   0C00 E5                                 PUSH    HL                  ; save the alien entry pointer
2865   0C01 7D                                 LD      A,L                 ; L = $72,$76,$7A,... (screen-X field of this alien)
2866   0C02 D6 72                              SUB     $72                 ; -> 0,4,8,... = 4 * alien index
2867   0C04 0F                                 RRCA                        ; /2 -> 0,2,4,... = 2 * alien index
2868   0C05 C6 50                              ADD     $50                 ; -> $50 + 2*index
2869   0C07 6F                                 LD      L,A                 ; HL = $4B50 + 2*index (this alien's pattern pointer)
2870   0C08 7E                                 LD      A,(HL)              ; get MSB pointer of alien movement pattern
2871   0C09 2C                                 INC     L                   ; 
2872   0C0A 6E                                 LD      L,(HL)              ; get LSB pointer of alien movement pattern
2873   0C0B 67                                 LD      H,A                 ; HL = alien's current position in its pattern list
2874   0C0C 11 04 0C                           LD      DE,$0C04            ; default: D=$0C anim index, E=$04 normal-kill score
2875   0C0F 7E                                 LD      A,(HL)              ; get movement pattern value (current phase)
2876   0C10 E1                                 POP     HL                  ; restore the alien entry pointer
2877   0C11 FE 07                              CP      $07                 ; 
2878   0C13 DA A4 0E                           JP      C,L0EA4             ; phase < $07: normal kill
2879   0C16 FE 09                              CP      $09                 ; 
2880   0C18 D2 A4 0E                           JP      NC,L0EA4            ; phase >= $09: normal kill
2881   0C1B             ; Else phase is $07 or $08 -> BONUS
2882   0C1B 11 20 10                           LD      DE,$1020            ; D=$10 anim index, E=$20 bonus explosion score 200
2883   0C1E 3E FF                              LD      A,$FF               ; set bonus explosion flag
2884   0C20 32 69 43                           LD      (M4369),A           ; $4369 = 'bonus explosion'
2885   0C23 C3 A4 0E                           JP      L0EA4               ; kill with the bonus values
2886   0C26             
2887   0C40                                    .ORG $0C40
2888   0C40             ;*****************************************************************************
