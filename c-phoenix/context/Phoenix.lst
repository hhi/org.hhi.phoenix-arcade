2665   0AEA             L0AEA:
2666   0AEA 21 B9 43                           LD      HL,CounterB9        ;
2667   0AED 7E                                 LD      A,(HL)              
2668   0AEE E6 F8                              AND     $F8                 
2669   0AF0 77                                 LD      (HL),A              
2670   0AF1 32 00 58                           LD      (scrollRegister),A  ; 58xx scroll register
2671   0AF4 2E E2                              LD      L,$E2               
2672   0AF6 56                                 LD      D,(HL)              
2673   0AF7 2C                                 INC     L                   
2674   0AF8 5E                                 LD      E,(HL)              
2675   0AF9 CD 10 02                           CALL    LeftOneColumn       ;
2676   0AFC 1B                                 DEC     DE                  
2677   0AFD 00                                 NOP                         
2678   0AFE 2E A5                              LD      L,$A5               
2679   0B00 35                                 DEC     (HL)                
2680   0B01 7E                                 LD      A,(HL)              
2681   0B02 CA 15 0B                           JP      Z,L0B15             ;
2682   0B05 FE 20                              CP      $20                 
2683   0B07 DA A0 0B                           JP      C,L0BA0             ;
2684   0B0A CA 80 03                           JP      Z,ClearForeground   ;
2685   0B0D C3 BA 0B                           JP      L0BBA               ;
