1522   0515 CD 1E 04                           CALL    SetBitsVideoRegister; set color palette according to LevelAndRound
1523   0518 21 A4 43                           LD      HL,GameState        ; Next interval game state ...
1524   051B 36 03                              LD      (HL),$03            ; ... is 3 (normal game play)
1525   051D CD 80 05                           CALL    InitGlobalLevelData ;
1526   0520 CD 47 05                           CALL    InitPlayerDataStructure
1527   0523 CD A0 09                           CALL    L09A0               ; get screen ram adress for player ship position
1528   0526             L0526:
