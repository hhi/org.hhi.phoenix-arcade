6834   31D7 07                                 RLCA                        ; Multiply by 8 ..
6835   31D8 07                                 RLCA                        ; ..
6836   31D9 07                                 RLCA                        ; ..
6837   31DA E6 07                              AND     $07                 
6838   31DC C6 00                              ADD     $00                 ; LSB for table T3300
6839   31DE 6F                                 LD      L,A                 
6840   31DF 26 33                              LD      H,$33               ; get MSB for table T3300
6841   31E1 7E                                 LD      A,(HL)              
6842   31E2 81                                 ADD     A,C                 
6843   31E3 07                                 RLCA                        ; Multiply by 4 ..
6844   31E4 07                                 RLCA                        ; ..
6845   31E5 4F                                 LD      C,A                 
6846   31E6 00                                 NOP                         
6847   31E7 00                                 NOP                         
