2365   0933 C2 64 09                           JP      NZ,L0964            ; update PlayerBulletY (grid) and PlayerBulletState
2366   0936 EB                                 EX      DE,HL               ;
2367   0937 06 10                              LD      B,$10               ; 0001_0000 (bit4='fire')
2368   0939 CD BB 00                           CALL    CheckInputBits      ;
2369   093C C8                                 RET     Z                   ; return if button not pressed
2370   093D 7E                                 LD      A,(HL)              ;
