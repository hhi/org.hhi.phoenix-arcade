1574   0580             ;*****************************************************************************
1575   0580             ;* Init of global level data, dependent on level and round.
1576   0580             ;*****************************************************************************
1577   0580             InitGlobalLevelData:
1578   0580 21 98 05                           LD      HL,T0598            ;
1579   0583 3A B8 43                           LD      A,(LevelAndRound)   ;
1580   0586 E6 0F                              AND     $0F                 ;
1581   0588 85                                 ADD     A,L                 ;
1582   0589 6F                                 LD      L,A                 ;
1583   058A 6E                                 LD      L,(HL)              ;
1584   058B 26 05                              LD      H,$05               ;
1585   058D 11 AB 43                           LD      DE,M43AB            ;
1586   0590 06 0C                              LD      B,$0C               ; number of bytes to copy
1587   0592 CD E0 05                           CALL    CopyBbytesHLtoDE    ;
1588   0595 C9                                 RET                         ;
1589   0596             
1590   0598                                    .ORG $0598
1591   0598             ; Table for the global level data, over game levels.
1592   0598             ; Bit0 - bit3 of $43B8 is the table index.
1593   0598             ; Data will be fetched two times. Once before and once after the 'spiral fill' animation.
1594   0598             T0598:
1595   0598 A8 A8                              .DB T05A8 & $FF, T05A8 & $FF    ;init values for 1st alien wave (pointer to $05A8, $05A8)
1596   059A C0 C0                              .DB T05C0 & $FF, T05C0 & $FF    ;init values for 2st alien wave (pointer to $05C0, $05C0)
1597   059C A8 A8                              .DB T05A8 & $FF, T05A8 & $FF    ;init values for blue birds wave (pointer to $05A8, $05A8)
1598   059E A8 A8                              .DB T05A8 & $FF, T05A8 & $FF    ;init values for pink birds wave (pointer to $05A8, $05A8)
1599   05A0 B4 CC                              .DB T05B4 & $FF, T05CC & $FF    ;init values for mothership wave (pointer to $05B4, $05CC)
1600   05A2 B4 B4                              .DB T05B4 & $FF, T05B4 & $FF    ;init values for mothership wave (pointer to $05B4, $05B4)
1601   05A4 A8 A8                              .DB T05A8 & $FF, T05A8 & $FF    ;not used? pointer to $05A8, $05A8
1602   05A6 A8 A8                              .DB T05A8 & $FF, T05A8 & $FF    ;not used? pointer to $05A8, $05A8
1603   05A8             ;
1604   05A8             ; e.g.:counter values, timer values, T1C00, T1D00, T1F00, ..
1605   05A8             ; Data copied to $43AB-$43B6
1606   05A8             T05A8:
1607   05A8 80 7F 00 00                        .DB $80, $7F, $00, $00, $40, $3F, $00, T1C00 >> 8, T1C00 & $FF, $FF, $FF, $FF
1607   05AC 40 3F 00 1C 
1607   05B0 00 FF FF FF 
1608   05B4             T05B4:
1609   05B4 60 5F 01 02                        .DB $60, $5F, $01, $02, $30, $2F, $00, T1C00 >> 8, T1C00 & $FF, $C0, $FF, $FF
1609   05B8 30 2F 00 1C 
1609   05BC 00 C0 FF FF 
1610   05C0             T05C0:
1611   05C0 80 7F 03 04                        .DB $80, $7F, $03, $04, $40, $3F, $00, T1F00 >> 8, T1F00 & $FF, $A0, $FF, $FF
1611   05C4 40 3F 00 1F 
1611   05C8 00 A0 FF FF 
1612   05CC             T05CC:
1613   05CC 60 60 05 06                        .DB $60, $60, $05, $06, $50, $30, $00, T1D00 >> 8, T1D00 & $FF, $48, $FF, $FF
1613   05D0 50 30 00 1D 
1613   05D4 00 48 FF FF 
