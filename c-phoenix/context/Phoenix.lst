1988   0771 23                                 INC     HL                  ;
1989   0772 5E                                 LD      E,(HL)              ; get LSB screen ram adress of alien
1990   0773 0A                                 LD      A,(BC)              ; get alien control state B
1991   0774 12                                 LD      (DE),A              ; set at screen ram
1992   0775 0B                                 DEC     BC                  ; move to alien control state A
1993   0776 C9                                 RET                         ;
