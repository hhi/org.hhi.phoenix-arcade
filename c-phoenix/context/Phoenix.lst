5419   2399 E6 F7                              AND     $F7                 
5420   239B 12                                 LD      (DE),A              
5421   239C 1C                                 INC     E                   
5422   239D 1C                                 INC     E                   
5423   239E 1A                                 LD      A,(DE)              
5424   239F E6 04                              AND     $04                 
5425   23A1 78                                 LD      A,B                 
5426   23A2 C2 30 20                           JP      NZ,L2030            ; 
5427   23A5 E6 0C                              AND     $0C                 
5428   23A7 FE 04                              CP      $04                 
5429   23A9 11 40 1B                           LD      DE,$1B40            
5430   23AC             L23AC:
