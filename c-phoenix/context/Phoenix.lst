2946   0C87 C8                                 RET     Z                   
2947   0C88 00                                 NOP                         
2948   0C89 00                                 NOP                         
2949   0C8A 2C                                 INC     L                   
2950   0C8B 7E                                 LD      A,(HL)              
2951   0C8C EE 04                              XOR     $04                 
2952   0C8E 77                                 LD      (HL),A              
2953   0C8F 2C                                 INC     L                   
2954   0C90 2C                                 INC     L                   
2955   0C91 7E                                 LD      A,(HL)              
2956   0C92 C6 04                              ADD     $04                 
2957   0C94 77                                 LD      (HL),A              
2958   0C95 FE F9                              CP      $F9                 
2959   0C97 D2 6E 09                           JP      NC,L096E            ; 
2960   0C9A 2D                                 DEC     L                   
2961   0C9B CD B4 0C                           CALL    L0CB4               ; 
2962   0C9E 54                                 LD      D,H                 
2963   0C9F 7D                                 LD      A,L                 
2964   0CA0 C6 20                              ADD     $20                 
2965   0CA2 5F                                 LD      E,A                 
2966   0CA3 EB                                 EX      DE,HL               
