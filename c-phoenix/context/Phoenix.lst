8359   3A34 2E 8D                              LD      L,$8D               
8360   3A36 77                                 LD      (HL),A              
8361   3A37 2E 68                              LD      L,$68               
8362   3A39 36 00                              LD      (HL),$00            
8363   3A3B 2E 66                              LD      L,$66               
