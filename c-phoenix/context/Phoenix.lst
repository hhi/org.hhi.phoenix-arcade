3903   14E0             ;*****************************************************************************
3904   14E0             ;* Coin-text fixup, run after each character of the '$18xx' text is printed.
3905   14E0             ;* If the coinage DIP bit is set, three positions in the "INSERT COIN"
3906   14E0             ;* block are overwritten with alternate glyphs, otherwise the text is
3907   14E0             ;* left as printed.
3908   14E0             ;* In:  A = printed char, HL = source text ptr ($18xx), DE = screen addr.
3909   14E0             ;* The quirky flag trick:
3910   14E0             ;* Notice the routine writes to the screen before it tests the match
3911   14E0             ;* (`LD (HL),$22` sits before `RET Z`). Because `LD (HL),n` doesn't touch the flags,
3912   14E0             ;* the `RET Z` still reflects the preceding `CP`. So on a non match
3913   14E0             ;* the "wrong" byte is written but then immediately corrected by the next `LD (HL),...`
3914   14E0             ;* (and ultimately by `LD (HL),B` at `$14FC`). It's a code size optimization:
3915   14E0             ;* only the last write that is followed by a taken `RET Z` actually sticks.
3916   14E0             ;*****************************************************************************
3917   14E0             L14E0:
3918   14E0 47                                 LD      B,A                 ; save the printed character
3919   14E1 3A 00 78                           LD      A,(DSW0)            ; 78xx DSW0 (DIP switches)
3920   14E4 E6 10                              AND     $10                 ; 0001_0000 Coinage
3921   14E6 C8                                 RET     Z                   ; coinage bit clear -> keep text as-is
3922   14E7 EB                                 EX      DE,HL               ; HL = screen addr, DE = source text ptr
3923   14E8 7A                                 LD      A,D                 ; source MSB
3924   14E9 FE 18                              CP      $18                 ; is this the $18xx text block ?
3925   14EB C0                                 RET     NZ                  ; if not, leave it alone
3926   14EC 7B                                 LD      A,E                 ; source LSB (position within text)
3927   14ED FE 95                              CP      $95                 ; position $1895 ?
3928   14EF 36 22                              LD      (HL),$22            ; overwrite screen char with $22: "2"
3929   14F1 C8                                 RET     Z                   ; ...and done if it was $1895
3930   14F2 FE 9A                              CP      $9A                 ; position $189A ?
3931   14F4 36 13                              LD      (HL),$13            ; overwrite with $13: "S"
3932   14F6 C8                                 RET     Z                   ; ...done if $189A
3933   14F7 FE B5                              CP      $B5                 ; position $18B5 ?
3934   14F9 36 24                              LD      (HL),$24            ; overwrite with $24: "4"
3935   14FB C8                                 RET     Z                   ; ...done if $18B5
3936   14FC 70                                 LD      (HL),B              ; otherwise restore the original character
3937   14FD C9                                 RET                         ;
