1960   0763             ;*****************************************************************************
1961   0763             ;* Bit4 control function 63:
1962   0763             ;* If control state A: 0001_xxxx
1963   0763             ;* Delete 1x1 screen objects (bullet, alien).
1964   0763             ;*****************************************************************************
1965   0763             L0763:
1966   0763 EB                                 EX      DE,HL               ;
1967   0764 56                                 LD      D,(HL)              ; get screen ram adress MSB
1968   0765 23                                 INC     HL                  ;
1969   0766 5E                                 LD      E,(HL)              ; get screen ram adress LSB
1970   0767 2B                                 DEC     HL                  ; restore pointer
1971   0768 AF                                 XOR     A                   ; A=0
1972   0769 12                                 LD      (DE),A              ; delete at screen
1973   076A EB                                 EX      DE,HL               ;
1974   076B C9                                 RET                         ;
