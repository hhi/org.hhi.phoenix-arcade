2383   0951 D6 08                              SUB     $08                 ;
2384   0953 12                                 LD      (DE),A              ;
2385   0954 1B                                 DEC     DE                  ;
2386   0955 EB                                 EX      DE,HL               ;
2387   0956 01 20 16                           LD      BC,T1620            ; get character for player bullets
2388   0959 CD 26 09                           CALL    L0926               ; get player ship animation frame values, mapped with T1600/T1620
2389   095C 3E 30                              LD      A,$30               ; 0011_0000
2390   095E 32 61 43                           LD      (BulletTriggered),A ; set 'bullet triggered' flag
2391   0961 C9                                 RET                         ;
