2747   0B60             ;*****************************************************************************
2748   0B60             L0B60:
2749   0B60 21 A5 43                           LD      HL,CounterA5        ;
2750   0B63 34                                 INC     (HL)                
2751   0B64 7E                                 LD      A,(HL)              
2752   0B65 FE 40                              CP      $40                 
2753   0B67 CA A0 03                           JP      Z,ClearBackground   ;
2754   0B6A 21 00 1A                           LD      HL,T1A00            ; "        GAME  OVER        "
2755   0B6D 0E 01                              LD      C,$01               
2756   0B6F FE 80                              CP      $80                 
2757   0B71 C2 95 0B                           JP      NZ,L0B95            ; 
2758   0B74 21 A4 43                           LD      HL,GameState        ; Next interval game state ...
2759   0B77 36 00                              LD      (HL),$00            ; ... is 0 (new game start)
2760   0B79 2E 90                              LD      L,$90               
2761   0B7B 7E                                 LD      A,(HL)              
2762   0B7C 2C                                 INC     L                   
2763   0B7D B6                                 OR      (HL)                
2764   0B7E C0                                 RET     NZ                  
2765   0B7F AF                                 XOR     A                   ; A=0
2766   0B80 2E 98                              LD      L,$98               
2767   0B82 77                                 LD      (HL),A              
2768   0B83 2C                                 INC     L                   
2769   0B84 77                                 LD      (HL),A              
2770   0B85 2E A2                              LD      L,$A2               
2771   0B87 77                                 LD      (HL),A              
2772   0B88 2C                                 INC     L                   
2773   0B89 7E                                 LD      A,(HL)              
2774   0B8A A7                                 AND     A                   ; updates the zero flag
2775   0B8B C8                                 RET     Z                   
2776   0B8C 36 00                              LD      (HL),$00            
2777   0B8E 01 00 01                           LD      BC,$0100            ; from bank 1 to bank 0
2778   0B91 CD 60 04                           CALL    CopyMemoryBank      ;
2779   0B94 C9                                 RET                         
