2437   09A0             ;*****************************************************************************
2438   09A0             ;* Get screen ram adress for player and bullet positions.
2439   09A0             ;* from: 43C2:43C3, 43C6:43C7, 43CA:43CB
2440   09A0             ;* ......PlayerShipX
2441   09A0             ;* ...........PlayerShipY
2442   09A0             ;* .................PlayerBulletX
2443   09A0             ;* ......................PlayerBulletY
2444   09A0             ;* ............................AbovePlayerBulletX
2445   09A0             ;* .................................AbovePlayerBulletY
2446   09A0             ;* to:   43E2:43E3, 43E6:43E7, 43EA:43EB
2447   09A0             ;*****************************************************************************
2448   09A0             L09A0:
2449   09A0 01 C2 43                           LD      BC,PlayerShipX      ;
2450   09A3 11 E2 43                           LD      DE,PlayerShipMSB    ;
2451   09A6             L09A6:
2452   09A6 CD BA 09                           CALL    GetScreenRamAddress ;
2453   09A9 03                                 INC     BC                  ;
2454   09AA 03                                 INC     BC                  ;
2455   09AB 03                                 INC     BC                  ;
2456   09AC 13                                 INC     DE                  ;
2457   09AD 13                                 INC     DE                  ;
2458   09AE 13                                 INC     DE                  ;
2459   09AF 79                                 LD      A,C                 ;
2460   09B0 FE CE                              CP      $CE                 ; end of data structure
2461   09B2 C2 A6 09                           JP      NZ,L09A6            ;
2462   09B5 C9                                 RET                         ;
2463   09B6             
