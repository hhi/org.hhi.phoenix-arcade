0246   0000             M4B5D                  .EQU $4B5D       ;Alien6 movement pattern table LSB
0247   0000             M4B5E                  .EQU $4B5E       ;Alien7 movement pattern table MSB
0248   0000             M4B5F                  .EQU $4B5F       ;Alien7 movement pattern table LSB
0249   0000             M4B60                  .EQU $4B60       ;Alien8 movement pattern table MSB
0250   0000             M4B61                  .EQU $4B61       ;Alien8 movement pattern table LSB
0251   0000             M4B62                  .EQU $4B62       ;Alien9 movement pattern table MSB
0252   0000             M4B63                  .EQU $4B63       ;Alien9 movement pattern table LSB
