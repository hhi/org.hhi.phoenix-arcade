8157   3937 6F                                 LD      L,A                 
8158   3938 26 3D                              LD      H,T3DC0 >> 8        ; MSB of table T3DC0
8159   393A 5E                                 LD      E,(HL)              
8160   393B 2C                                 INC     L                   
8161   393C 6E                                 LD      L,(HL)              
8162   393D 26 4B                              LD      H,$4B               
