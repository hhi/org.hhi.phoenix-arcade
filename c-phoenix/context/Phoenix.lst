6889   3221 06 02                              LD      B,$02               ; return B = phase 2
6890   3223 FE 98                              CP      $98                 ; 
6891   3225 D8                                 RET     C                   ; if alien screen coordinate Y < $98
6892   3226 06 03                              LD      B,$03               ; return B = phase 3
6893   3228 C9                                 RET                         ; 
