2465   09BA             ;*****************************************************************************
2466   09BA             ;* Mapping of 'grid values' to screen ram address.
2467   09BA             ;*****************************************************************************
2468   09BA             GetScreenRamAddress:
2469   09BA 21 00 0A                           LD      HL,T0A00            ; Screen ram addresses for the top row (left to right)
2470   09BD 0A                                 LD      A,(BC)              ; get the coordinate
2471   09BE E6 F8                              AND     $F8                 ; 1111_1000
2472   09C0 0F                                 RRCA                        ; 0111_1100
2473   09C1 0F                                 RRCA                        ; 0011_1110
2474   09C2 85                                 ADD     A,L                 ;
2475   09C3 6F                                 LD      L,A                 ;
2476   09C4 7E                                 LD      A,(HL)              ; get MSB of screen ram address for row
2477   09C5 12                                 LD      (DE),A              ; save it
2478   09C6 03                                 INC     BC                  ;
2479   09C7 13                                 INC     DE                  ;
2480   09C8 23                                 INC     HL                  ; move to LSB for T0A00
2481   09C9 0A                                 LD      A,(BC)              ; get the coordinate
2482   09CA E6 F8                              AND     $F8                 ; 1111_1000
2483   09CC 0F                                 RRCA                        ; 0111_1100
2484   09CD 0F                                 RRCA                        ; 0011_1110
2485   09CE 0F                                 RRCA                        ; 0001_1111
2486   09CF 86                                 ADD     A,(HL)              ; add to LSB of screen ram address for row
2487   09D0 12                                 LD      (DE),A              ; save it
2488   09D1 C9                                 RET                         ;
2489   09D2             
2490   0A00                                    .ORG $0A00
2491   0A00             ; Screen ram addresses for the top row (left to right)
2492   0A00             ; Notice these addresses are MSB:LSB (backwards from the processors endianness)
2493   0A00             ; The offset is `(X & $F8) >> 2`, which ranges `$00`…`$3E`.
2494   0A00             ; The 26 valid columns use offsets `$00`–`$32` (`$0A00`–`$0A33`).
2495   0A00             ; Any X coordinate large enough to produce offset `$34`–`$3E` lands in your range and reads `$0000`.
2496   0A00             ; Because the entry is `$0000` for both MSB and the row base LSB,
2497   0A00             ; the computed destination collapses to address `$0000` (plus a tiny Y offset),
2498   0A00             ; i.e. low ROM, where writes are simply ignored.
2499   0A00             ; The result is that an object pushed past the right edge is "drawn" to a harmless null address
2500   0A00             ; instead of corrupting screen RAM or wrapping onto a visible tile.
2501   0A00             T0A00:
2502   0A00                                    .MSFIRST
2503   0A00 43 20                              .DW ForegroundScreen+$320  ; Upper left corner of rotated screen
2504   0A02 43 00                              .DW ForegroundScreen+$300
2505   0A04 42 E0                              .DW ForegroundScreen+$2E0
2506   0A06 42 C0                              .DW ForegroundScreen+$2C0
2507   0A08 42 A0                              .DW ForegroundScreen+$2A0
2508   0A0A 42 80                              .DW ForegroundScreen+$280
2509   0A0C 42 60                              .DW ForegroundScreen+$260
2510   0A0E 42 40                              .DW ForegroundScreen+$240
2511   0A10 42 20                              .DW ForegroundScreen+$220
2512   0A12 42 00                              .DW ForegroundScreen+$200
2513   0A14 41 E0                              .DW ForegroundScreen+$1E0
2514   0A16 41 C0                              .DW ForegroundScreen+$1C0
2515   0A18 41 A0                              .DW ForegroundScreen+$1A0
2516   0A1A 41 80                              .DW ForegroundScreen+$180
2517   0A1C 41 60                              .DW ForegroundScreen+$160
2518   0A1E 41 40                              .DW ForegroundScreen+$140
2519   0A20 41 20                              .DW ForegroundScreen+$120
2520   0A22 41 00                              .DW ForegroundScreen+$100
2521   0A24 40 E0                              .DW ForegroundScreen+$E0
2522   0A26 40 C0                              .DW ForegroundScreen+$C0
2523   0A28 40 A0                              .DW ForegroundScreen+$A0
2524   0A2A 40 80                              .DW ForegroundScreen+$80
2525   0A2C 40 60                              .DW ForegroundScreen+$60
2526   0A2E 40 40                              .DW ForegroundScreen+$40
2527   0A30 40 20                              .DW ForegroundScreen+$20
2528   0A32 40 00                              .DW ForegroundScreen       ; Upper right corner of rotated screen
2529   0A34             
2530   0A34             ; Mapping the 'out of screen' objects,
2531   0A34             ; that catch coordinates mapping beyond the 26 columns, returning a null (`$0000`) address
2532   0A34             ; so off screen objects are written to a safe, ignored location rather than drawn as garbage.
2533   0A34 00 00                              .DB $00, $00
2534   0A36 00 00                              .DB $00, $00
2535   0A38 00 00                              .DB $00, $00
2536   0A3A 00 00                              .DB $00, $00
2537   0A3C 00 00                              .DB $00, $00
2538   0A3E 00 00                              .DB $00, $00
2539   0A40             ;
2540   0A40             T0A40:
2541   0A40 AA BA AB BB                        .DB $AA, $BA, $AB, $BB     ;alien shape #37 (set A)
2542   0A44 80 90 81 91                        .DB $80, $90, $81, $91     ;alien shape #34 (set A)
2543   0A48             T0A48:
2544   0A48 74 7C 75 7D                        .DB $74, $7C, $75, $7D     ;alien pilot shape (set B)
2545   0A4C             
2546   0A50                                    .ORG $0A50
2547   0A50             ;*****************************************************************************
2548   0A50             ;* Handle alien control states for all aliens.
2549   0A50             ;* This routine has a bug!
2550   0A50             ;* Loop goes 20 times for 16 aliens. But bit 3 or 4 is not set at
2551   0A50             ;* UpdateScreenObjects. So luckily no effect.
2552   0A50             ;* Possible fix would be: 'CP $F0' at $0A63.
2553   0A50             ;*****************************************************************************
2554   0A50             AlienDataController:
2555   0A50 01 70 4B                           LD      BC,M4B70            ; alien data structure (grid)
2556   0A53 11 B0 4B                           LD      DE,M4BB0            ; alien data structure (screen ram)
2557   0A56             L0A56:
2558   0A56 C5                                 PUSH    BC                  ;
2559   0A57 CD 18 07                           CALL    UpdateScreenObjects ;
2560   0A5A C1                                 POP     BC                  ;
2561   0A5B 79                                 LD      A,C                 ;
2562   0A5C C6 04                              ADD     $04                 ;
2563   0A5E 4F                                 LD      C,A                 ;
2564   0A5F C6 40                              ADD     $40                 ;
2565   0A61 5F                                 LD      E,A                 ;
2566   0A62 50                                 LD      D,B                 ;
2567   0A63 A7                                 AND     A                   ; updates the zero flag (bug)
2568   0A64 C2 56 0A                           JP      NZ,L0A56            ;
2569   0A67 C9                                 RET                         ;
2570   0A68             
2571   0A6C                                    .ORG $0A6C
2572   0A6C             ;*****************************************************************************
2573   0A6C             ;* Get screen ram adress for all aliens.
2574   0A6C             ;*****************************************************************************
2575   0A6C             L0A6C:
2576   0A6C 01 70 4B                           LD      BC,M4B70            ; data structure for alien control and screen coordinate
2577   0A6F 11 B3 4B                           LD      DE,M4BB3            ; data structure for alien screen ram address
2578   0A72             L0A72:
2579   0A72 C5                                 PUSH    BC                  ;
2580   0A73 D5                                 PUSH    DE                  ;
2581   0A74 0A                                 LD      A,(BC)              ;
2582   0A75 E6 18                              AND     $18                 ; mask out 0001_1000
2583   0A77 CA 8A 0A                           JP      Z,L0A8A             ; if 0 then skip the mapping
2584   0A7A EB                                 EX      DE,HL               ;
2585   0A7B 56                                 LD      D,(HL)              ;
2586   0A7C 2B                                 DEC     HL                  ;
2587   0A7D 5E                                 LD      E,(HL)              ;
2588   0A7E 2B                                 DEC     HL                  ;
2589   0A7F 72                                 LD      (HL),D              ;
2590   0A80 2B                                 DEC     HL                  ;
2591   0A81 73                                 LD      (HL),E              ;
2592   0A82 EB                                 EX      DE,HL               ;
2593   0A83 13                                 INC     DE                  ;
2594   0A84 13                                 INC     DE                  ;
2595   0A85 03                                 INC     BC                  ;
2596   0A86 03                                 INC     BC                  ;
2597   0A87 CD BA 09                           CALL    GetScreenRamAddress ;
2598   0A8A             L0A8A:
2599   0A8A D1                                 POP     DE                  ;
2600   0A8B C1                                 POP     BC                  ;
2601   0A8C 79                                 LD      A,C                 ;
2602   0A8D C6 04                              ADD     $04                 ;
2603   0A8F 4F                                 LD      C,A                 ;
2604   0A90 7B                                 LD      A,E                 ;
2605   0A91 C6 04                              ADD     $04                 ;
2606   0A93 5F                                 LD      E,A                 ;
2607   0A94 FE 03                              CP      $03                 ;
2608   0A96 C2 72 0A                           JP      NZ,L0A72            ;
2609   0A99 C9                                 RET                         ;
2610   0A9A             
2611   0AA0                                    .ORG $0AA0
2612   0AA0             ;*****************************************************************************
2613   0AA0             ;* Handler for the player shield.
2614   0AA0             ;*****************************************************************************
2615   0AA0             DrawShields:
2616   0AA0 2E E2                              LD      L,PlayerShipMSB & $FF     ; HL=43E2 Player's screen memory location
2617   0AA2 56                                 LD      D,(HL)              ; Get the PlayerScreenRamMSB
2618   0AA3 23                                 INC     HL                  ; Get the ... PlayerScreenRamLSB
2619   0AA4 5E                                 LD      E,(HL)              ; ... LSB (ignore any fine bit shifting of the player)
2620   0AA5 CD 10 02                           CALL    LeftOneColumn       ; Shield pictures begin one column to the left of the ship
2621   0AA8 1B                                 DEC     DE                  ; Shield pictures begin one row above the ship
2622   0AA9 01 04 04                           LD      BC,$0404            ; Shiled images are 4x4
2623   0AAC 2E A6                              LD      L,ShieldCount & $FF ; Decrement the ...
2624   0AAE 35                                 DEC     (HL)                ; ... shield counter
2625   0AAF 7E                                 LD      A,(HL)              ; Current shield counter value
2626   0AB0 21 F0 17                           LD      HL,FourByFourEmpty  ; Blank 4x4
2627   0AB3 FE C0                              CP      $C0                 ; Shield time done?
2628   0AB5 CA 48 0B                           JP      Z,ShieldsExpired    ; Yes ... turn shields off
2629   0AB8 21 70 17                           LD      HL,T1770            ; Four shield-active pictures
2630   0ABB E6 0C                              AND     $0C                 ; Drop lower 2 bits (0000_1100). Images change every 4 ticks.
2631   0ABD 07                                 RLCA                        ; Multiply by 4 ...
2632   0ABE 07                                 RLCA                        ; ... to get a 16-byte offest (4x4 pictures)
2633   0ABF 85                                 ADD     A,L                 ; Point to the ...
2634   0AC0 6F                                 LD      L,A                 ; ... correct image
2635   0AC1 C3 D6 0A                           JP      DrawImageCbyB       ; Draw the new shield image
2636   0AC4             
2637   0AD6                                    .ORG $0AD6
2638   0AD6             ;*****************************************************************************
2639   0AD6             ; B is number of rows
2640   0AD6             ; C is number of columns
2641   0AD6             ; HL is the data
2642   0AD6             ; DE is the pointer to the screen
2643   0AD6             ;*****************************************************************************
2644   0AD6             DrawImageCbyB:
2645   0AD6 D5                                 PUSH    DE                  ; Hold screen pointer
2646   0AD7 C5                                 PUSH    BC                  ; Hold width/Height
2647   0AD8             L0AD8:
2648   0AD8 7E                                 LD      A,(HL)              ; Character to ...
2649   0AD9 12                                 LD      (DE),A              ; ... the screen
2650   0ADA 23                                 INC     HL                  ; Next in data
2651   0ADB 13                                 INC     DE                  ; Next column on screen
2652   0ADC 05                                 DEC     B                   ; All rows done in this column?
2653   0ADD C2 D8 0A                           JP      NZ,L0AD8            ; No ... finish the rows
2654   0AE0 C1                                 POP     BC                  ; Restore the counters
2655   0AE1 D1                                 POP     DE                  ; Restore the screen pointer
2656   0AE2 CD 17 02                           CALL    RightOneColumn      ; Move over one column
2657   0AE5 0D                                 DEC     C                   ; All columns done?
2658   0AE6 C2 D6 0A                           JP      NZ,DrawImageCbyB    ; No ... do all columns
2659   0AE9 C9                                 RET                         ; Done
