2004   077B 23                                 INC     HL                  ;
2005   077C 5E                                 LD      E,(HL)              ;
2006   077D 2B                                 DEC     HL                  ; restore pointer
2007   077E AF                                 XOR     A                   ; A=0
2008   077F 12                                 LD      (DE),A              ; delete at screen, left part
2009   0780 CD 17 02                           CALL    RightOneColumn      ; 
2010   0783 AF                                 XOR     A                   ; A=0
