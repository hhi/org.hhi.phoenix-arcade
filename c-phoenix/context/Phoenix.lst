7350   3560             ;*****************************************************************************
7351   3560             ;* Bird-launch setup:
7352   3560             ;* Decides the parameters of the next incoming bird group.
7353   3560             ;* Builds a random horizontal jitter, then composes an index from the current game state.
7354   3560             ;* The index is `bit5(timing) | round(bits 3 4) | (BirdsLeft 1)(bits 1 2)`,
7355   3560             ;* which spans `$00`–`$3E` in steps of 2 -> addresses `$3E80`–`$3EBE`.
7356   3560             ;* So the table is 32 two byte entries, selected by:
7357   3560             ;* - Game round (`LevelAndRound`, clamped at round 4) -> one of 4 difficulty groups
7358   3560             ;* - Birds remaining (`BirdsLeft 1`, clamped to 0–3) -> entry within the group
7359   3560             ;* - A timing bit from `Counter9A` -> alternates between the two halves of the table
7360   3560             ;* They're then consumed by the bird movement/attack code.
7361   3560             ;*****************************************************************************
7362   3560             L3560:
7363   3560 CD AA 30                           CALL    GetRandomNumber     ; 
7364   3563 47                                 LD      B,A                 ;
7365   3564 07                                 RLCA                        ; Multiply by 4 ..
7366   3565 07                                 RLCA                        ; ..
7367   3566 4F                                 LD      C,A                 ;
7368   3567 07                                 RLCA                        ; Multiply by 4 ..
7369   3568 07                                 RLCA                        ; ..
7370   3569 B0                                 OR      B                   
7371   356A 32 6F 43                           LD      (M436F),A           ; 
7372   356D 3A B8 43                           LD      A,(LevelAndRound)   ; 
7373   3570 FE 40                              CP      $40                 ;
7374   3572 DA 77 35                           JP      C,L3577             ; if game round < 4
7375   3575 3E 30                              LD      A,$30               
7376   3577             L3577:
7377   3577 E6 30                              AND     $30                 
7378   3579 0F                                 RRCA                        
7379   357A 47                                 LD      B,A                 
7380   357B 3A BB 43                           LD      A,(BirdsLeft)       ; 
7381   357E 3D                                 DEC     A                   
7382   357F FE 04                              CP      $04                 
7383   3581 DA 86 35                           JP      C,L3586             ; 
7384   3584 3E 03                              LD      A,$03               
7385   3586             L3586:
7386   3586 07                                 RLCA                        ; Multiply by 2
7387   3587 B0                                 OR      B                   
7388   3588 47                                 LD      B,A                 
7389   3589 3A 9A 43                           LD      A,(Counter9A)       ; 
7390   358C 07                                 RLCA                        ; Multiply by 4 ..
7391   358D 07                                 RLCA                        ; ..
7392   358E E6 20                              AND     $20                 ; mask out 0010_0000
7393   3590 B0                                 OR      B                   
7394   3591 C6 80                              ADD     $80                 
7395   3593 6F                                 LD      L,A                 
7396   3594 26 3E                              LD      H,$3E               
7397   3596 7E                                 LD      A,(HL)              ; data from table T3E80
7398   3597 32 6E 43                           LD      (M436E),A           ; 
7399   359A 2C                                 INC     L                   
7400   359B 7E                                 LD      A,(HL)              ; data from table T3E80
7401   359C 81                                 ADD     A,C                 
7402   359D E6 F8                              AND     $F8                 
7403   359F 32 6D 43                           LD      (M436D),A           ; 
7404   35A2 C9                                 RET                         
7405   35A3             
7406   35B0                                    .ORG $35B0
7407   35B0             ;*****************************************************************************
7408   35B0             ;* The dispatch trick:
7409   35B0             ;* `L35B0` is called with `HL` -> the bird's record.
7410   35B0             ;* It reads the state index at record offset +0, then (crucially) advances `HL`
7411   35B0             ;* to offset +4 and passes that pointer along.
7412   35B0             ;* It then looks up `T3F00 + index*8` and pushes four 16 bit values, then does `RET`.
7413   35B0             ;*****************************************************************************
7414   35B0             L35B0:
7415   35B0 7E                                 LD      A,(HL)              ; get index character block shape
7416   35B1 A7                                 AND     A                   ; updates the zero flag
7417   35B2 C8                                 RET     Z                   ; if index is 0
7418   35B3 47                                 LD      B,A                 ; save index to B
7419   35B4 2C                                 INC     L                   ;
7420   35B5 2C                                 INC     L                   ;
7421   35B6 2C                                 INC     L                   ;
7422   35B7 2C                                 INC     L                   ;
7423   35B8 7E                                 LD      A,(HL)              ;
7424   35B9 A7                                 AND     A                   ; updates the zero flag
7425   35BA CA BE 35                           JP      Z,L35BE             ; 
7426   35BD 35                                 DEC     (HL)                ;
7427   35BE             L35BE:
7428   35BE EB                                 EX      DE,HL               ;
7429   35BF D5                                 PUSH    DE                  ;
7430   35C0 78                                 LD      A,B                 ; load index
7431   35C1 07                                 RLCA                        ; Multiply by 8 ..
7432   35C2 07                                 RLCA                        ; ..
7433   35C3 07                                 RLCA                        ; ..
7434   35C4 6F                                 LD      L,A                 ;
7435   35C5 26 3F                              LD      H,$3F               ; MSB of table T3F00 for stack manipulation
7436   35C7 46                                 LD      B,(HL)              ; get 1st byte
7437   35C8 23                                 INC     HL                  ;
7438   35C9 4E                                 LD      C,(HL)              ; get 2nd byte
7439   35CA C5                                 PUSH    BC                  ; to stack
7440   35CB 23                                 INC     HL                  ;
7441   35CC 46                                 LD      B,(HL)              ; get 3rd byte
7442   35CD 23                                 INC     HL                  ;
7443   35CE 4E                                 LD      C,(HL)              ; get 4rd byte
7444   35CF C5                                 PUSH    BC                  ; to stack
7445   35D0 23                                 INC     HL                  ;
7446   35D1 46                                 LD      B,(HL)              ; get MSB of 1st address
7447   35D2 23                                 INC     HL                  ;
7448   35D3 4E                                 LD      C,(HL)              ; get LSB of 1st address
7449   35D4 C5                                 PUSH    BC                  ; to stack
7450   35D5 23                                 INC     HL                  ;
7451   35D6 46                                 LD      B,(HL)              ; get MSB of 2nd address
7452   35D7 23                                 INC     HL                  ;
7453   35D8 4E                                 LD      C,(HL)              ; get LSB of 2nd address
7454   35D9 C5                                 PUSH    BC                  ; to stack
7455   35DA EB                                 EX      DE,HL               ;
7456   35DB C9                                 RET                         ; calls the 2nd address
7457   35DC             ;*****************************************************************************
7458   35DC             ;* Because the 2nd address was pushed last, `RET` jumps there first. So the sequence is:
7459   35DC             ;* 1. `RET` -> 2nd address (`$35E0` or `$36C0`) runs first, with `HL` = bird record +4.
7460   35DC             ;*    These are the movement / animation routines. They do their work and finish with their own `RET`.
7461   35DC             ;* 2. That `RET` pops the next stack item — the 1st address (`$36CC`, `$36D2`, `$36EA`, or `$370A`)
7462   35DC             ;*     — and jumps there. These are the state transition routines.
7463   35DC             ;*     They begin by popping the two constants and the bird pointer back off the stack.
7464   35DC             ;*****************************************************************************
7465   35DC             
