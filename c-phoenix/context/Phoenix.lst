2688   0B15             ;*****************************************************************************
2689   0B15             ;* The explosion is over — it reloads `CounterA5=5`, decrements that player's life count,
2690   0B15             ;* refreshes the lives display, and sets `GameState = 0` (new turn / next player start).
2691   0B15             ;*****************************************************************************
2692   0B15             L0B15:
2693   0B15 2D                                 DEC     L                   ;
2694   0B16 36 05                              LD      (HL),$05            ;
2695   0B18 2D                                 DEC     L                   ;
2696   0B19 7E                                 LD      A,(HL)              ;
2697   0B1A C6 90                              ADD     $90                 ; -> Player1Lives / Player2Lives slot                 
2698   0B1C 6F                                 LD      L,A                 ;
2699   0B1D 7E                                 LD      A,(HL)              ;
2700   0B1E A7                                 AND     A                   ; updates the zero flag
2701   0B1F C8                                 RET     Z                   ;
2702   0B20 35                                 DEC     (HL)                ; lose a life
2703   0B21 E5                                 PUSH    HL                  ;
2704   0B22 CD 67 03                           CALL    UpdateLivesScreen   ;
2705   0B25 E1                                 POP     HL                  ;
2706   0B26 7E                                 LD      A,(HL)              ;
2707   0B27 A7                                 AND     A                   ; updates the zero flag
2708   0B28 C8                                 RET     Z                   ;
2709   0B29 2E A4                              LD      L,$A4               ; GameState
2710   0B2B 36 00                              LD      (HL),$00            ; set to: 'new game start'
2711   0B2D C9                                 RET                         ;
2712   0B2E             
