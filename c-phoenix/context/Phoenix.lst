5443   23C0             ;*****************************************************************************
5444   23C0             ;* The mothership will be destroyed if an alien pilot is hit.
5445   23C0             ;* If the hit lands on the belt segment directly in front of the alien pilot,
5446   23C0             ;* `L23AC` takes the `JP Z,L23C0` branch instead, which checks whether the tile behind
5447   23C0             ;* is a pilot tile (`$70`-range) and, if so, destroys the mother ship.
5448   23C0             ;*****************************************************************************
5449   23C0             L23C0:
5450   23C0 2D                                 DEC     L                   
5451   23C1 7E                                 LD      A,(HL)              
5452   23C2 E6 F0                              AND     $F0                 
5453   23C4 FE 70                              CP      $70                 
5454   23C6 C0                                 RET     NZ                  
5455   23C7 21 A4 43                           LD      HL,GameState        ; Next interval game state ...
5456   23CA 36 06                              LD      (HL),$06            ; ... is 6 (mother ship partikel explosion)
5457   23CC 2C                                 INC     L                   
5458   23CD 36 60                              LD      (HL),$60            
5459   23CF 2E 63                              LD      L,$63               
5460   23D1 36 FF                              LD      (HL),$FF            
5461   23D3 C9                                 RET                         
