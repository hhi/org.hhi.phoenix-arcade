5432   23AF 78                                 LD      A,B                 
5433   23B0 E6 0F                              AND     $0F                 
5434   23B2 83                                 ADD     A,E                 
5435   23B3 5F                                 LD      E,A                 
5436   23B4 1A                                 LD      A,(DE)              
5437   23B5 77                                 LD      (HL),A              
5438   23B6 3E FF                              LD      A,$FF               
5439   23B8 32 66 43                           LD      (M4366),A           ; 
5440   23BB C9                                 RET                         
