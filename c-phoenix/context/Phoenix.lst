1540   0537 CD D8 05                           CALL    ClearBbytesAtHL     ;
1541   053A CD EC 05                           CALL    InitAlienControlStates
1542   053D CD 50 06                           CALL    L0650               ; copy init values for 16 aliens to $4B50-$4B6F
1543   0540 CD 10 06                           CALL    InitAlienPositions  ; load alien screen coordinates (X,Y grid), for a new level and round
1544   0543 C9                                 RET                         ;
