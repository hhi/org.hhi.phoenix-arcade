2787   0BA0             ;*****************************************************************************
2788   0BA0             ;* Late cleanup: clear background, reset scroll on non‑mothership levels.
2789   0BA0             ;*****************************************************************************
2790   0BA0             L0BA0:
2791   0BA0 21 B8 43                           LD      HL,LevelAndRound    ;
2792   0BA3 7E                                 LD      A,(HL)              ;
2793   0BA4 E6 0F                              AND     $0F                 ; mask out 0000_1111
2794   0BA6 FE 04                              CP      $04                 ;
2795   0BA8 D8                                 RET     C                   ; return if < game level 4 (alien waves)
2796   0BA9 FE 09                              CP      $09                 ;
2797   0BAB D0                                 RET     NC                  ; return if > game level 9 (mothership)
2798   0BAC 2C                                 INC     L                   ; CounterB9
2799   0BAD AF                                 XOR     A                   ; A=0
2800   0BAE 77                                 LD      (HL),A              ; CounterB9 to 0
2801   0BAF 32 00 58                           LD      (scrollRegister),A  ; reset the 58xx scroll register
2802   0BB2 C3 A0 03                           JP      ClearBackground     ;
