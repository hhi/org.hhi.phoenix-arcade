6993   32B0             ;*****************************************************************************
6994   32B0             ;* Bird-level init:
6995   32B0             ;* First clears `$4B70`–`$4BAF`, then copies `BirdsLeft × 8` bytes from table T3F80
6996   32B0             ;* into the object array, choosing the source block by level.
6997   32B0             ;* So when a full wave starts (`BirdsLeft = 8`, `C = $40`),
6998   32B0             ;* the source LSB resolves to `$80` -> it copies the whole table starting at `$3F80` into `$4B70`,
6999   32B0             ;* meaning `$3F80`–`$3F87` becomes the live control block of bird #0 at `$4B70`.
7000   32B0             ;* (If fewer birds are present, both source and destination are offset toward the end of their respective arrays,
7001   32B0             ;* so the remaining birds are taken from the tail of the table.)
7002   32B0             ;* The `LevelAndRound` bit test redirects the source to `$3FC0` for levels 4/9.
7003   32B0             ;* After the copy, these objects are driven by the bird routines — e.g. `DrawFirst4BirdObjects`/`DrawSecond4BirdObjects`
7004   32B0             ;* and `L35B0`, all of which iterate the array in 8 byte steps (`ADD $08`) over `$4B70`–`$4BAF`, confirming the 8 byte-per-bird structure.
7005   32B0             ;*****************************************************************************
7006   32B0             L32B0:
7007   32B0 21 50 43                           LD      HL,M4350            ; 
7008   32B3 06 30                              LD      B,$30               ; 4350 to 437F
7009   32B5 CD D8 05                           CALL    ClearBbytesAtHL     ; 
7010   32B8 2E 9A                              LD      L,$9A               ;
7011   32BA 06 04                              LD      B,$04               ; 439A to 439D
7012   32BC CD D8 05                           CALL    ClearBbytesAtHL     ; 
7013   32BF 3A BB 43                           LD      A,(BirdsLeft)       ; 
7014   32C2 A7                                 AND     A                   ; updates the zero flag
7015   32C3 C8                                 RET     Z                   ; if no BirdsLeft
7016   32C4 07                                 RLCA                        ; Multiply by 8 ..
7017   32C5 07                                 RLCA                        ; ..
7018   32C6 07                                 RLCA                        ; ..
7019   32C7 4F                                 LD      C,A                 
7020   32C8 21 70 4B                           LD      HL,M4B70            ; 
7021   32CB 06 40                              LD      B,$40               
7022   32CD CD D8 05                           CALL    ClearBbytesAtHL     ; 
7023   32D0 16 4B                              LD      D,$4B               
7024   32D2 26 3F                              LD      H,$3F               
7025   32D4 3E 40                              LD      A,$40               
7026   32D6 91                                 SUB     C                   
7027   32D7 C6 70                              ADD     $70                 
7028   32D9 5F                                 LD      E,A                 
7029   32DA C6 10                              ADD     $10                 
7030   32DC 6F                                 LD      L,A                 
7031   32DD 41                                 LD      B,C                 
7032   32DE 3A B8 43                           LD      A,(LevelAndRound)   ; 
7033   32E1 0F                                 RRCA                        
7034   32E2 0F                                 RRCA                        
7035   32E3 D2 E0 05                           JP      NC,CopyBbytesHLtoDE ; 
7036   32E6 7D                                 LD      A,L                 
7037   32E7 C6 40                              ADD     $40                 
7038   32E9 6F                                 LD      L,A                 
7039   32EA C3 E0 05                           JP      CopyBbytesHLtoDE    ; 
