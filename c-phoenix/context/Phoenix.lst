2719   0B3E 03 0B                              .DB $03, $0B
2720   0B40 03 0B                              .DB $03, $0B
2721   0B42 02 0A                              .DB $02, $0A
2722   0B44 01 09                              .DB $01, $09
2723   0B46 00 08                              .DB $00, $08
