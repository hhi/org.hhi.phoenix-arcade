6060   2700             ;*****************************************************************************
6061   2700             ;* Handles the scoring, and the update of sound control HW.
6062   2700             ;*****************************************************************************
6063   2700             UpdateScoresAndSound:
6064   2700 21 A2 43                           LD      HL,GameOrAttract    ; 
6065   2703 7E                                 LD      A,(HL)              ; get it
6066   2704 A7                                 AND     A                   ; updates the zero flag
6067   2705 C8                                 RET     Z                   ; if GameOrAttract is 'Attract mode'.
6068   2706 2C                                 INC     L                   ;
6069   2707 7E                                 LD      A,(HL)              ; get GameAndDemoOrSplash
6070   2708 E6 01                              AND     $01                 ; mask out 0000_0001 'Game for player 2'
6071   270A 07                                 RLCA                        ; Multiply by 4 ..
6072   270B 07                                 RLCA                        ; ..
6073   270C C6 83                              ADD     $83                 ;
6074   270E 6F                                 LD      L,A                 ;
6075   270F 3E FF                              LD      A,$FF               ;
6076   2711 32 97 43                           LD      (M4397),A           ; 
6077   2714 11 70 43                           LD      DE,M4370            ; 
6078   2717             L2717:
6079   2717 CD 48 27                           CALL    L2748               ; add score values for all enemies hit.
6080   271A 1C                                 INC     E                   ;
6081   271B 1C                                 INC     E                   ;
6082   271C 1C                                 INC     E                   ;
6083   271D 7B                                 LD      A,E                 ;
6084   271E FE 80                              CP      $80                 ; from $4370 to $4380
6085   2720 C2 17 27                           JP      NZ,L2717            ; 
6086   2723 1E 9D                              LD      E,$9D               ;
6087   2725 3A A4 43                           LD      A,(GameState)       ; 
6088   2728 FE 06                              CP      $06                 ;
6089   272A C2 39 27                           JP      NZ,L2739            ; 
6090   272D 1A                                 LD      A,(DE)              ;
6091   272E 47                                 LD      B,A                 ;
6092   272F 0E 00                              LD      C,$00               ;
6093   2731 CD 20 02                           CALL    AddToScore          ; 
6094   2734 AF                                 XOR     A                   ; A=0
6095   2735 12                                 LD      (DE),A              ;
6096   2736 32 97 43                           LD      (M4397),A           ; 
6097   2739             L2739:
6098   2739 3A 97 43                           LD      A,(M4397)           ; 
6099   273C A7                                 AND     A                   ; updates the zero flag
6100   273D CC 68 27                           CALL    Z,L2768             ; if $4397 is 0.
6101   2740 CD A8 27                           CALL    UpdateSoundControlHW
6102   2743 C3 10 3A                           JP      L3A10               ; 
6103   2746             
6104   2748                                    .ORG $2748
6105   2748             ;*****************************************************************************
6106   2748             ;* Add score values for enemies hit.
6107   2748             ;*****************************************************************************
6108   2748             L2748:
6109   2748 1A                                 LD      A,(DE)              ; get $4370
6110   2749 1C                                 INC     E                   ;
6111   274A FE 01                              CP      $01                 ;
6112   274C C0                                 RET     NZ                  ; if not 1
6113   274D 1A                                 LD      A,(DE)              ;
6114   274E A7                                 AND     A                   ; updates the zero flag
6115   274F C8                                 RET     Z                   ;
6116   2750 0F                                 RRCA                        ; enemy has been hit
6117   2751 0F                                 RRCA                        ;
6118   2752 0F                                 RRCA                        ;
6119   2753 0F                                 RRCA                        ;
6120   2754 47                                 LD      B,A                 ;
6121   2755 E6 F0                              AND     $F0                 ;
6122   2757 4F                                 LD      C,A                 ;
6123   2758 78                                 LD      A,B                 ;
6124   2759 E6 0F                              AND     $0F                 ;
6125   275B 47                                 LD      B,A                 ;
6126   275C CD 20 02                           CALL    AddToScore          ; 
6127   275F AF                                 XOR     A                   ; Clear A Reg.
6128   2760 12                                 LD      (DE),A              ; clear the temp. score storage and ...
6129   2761 32 97 43                           LD      (M4397),A           ; ... the first two digits of BCD score value
6130   2764 C9                                 RET                         ;
6131   2765             
6132   2768                                    .ORG $2768
6133   2768             ;*****************************************************************************
6134   2768             ;* Score-display
6135   2768             ;* Together with `$43BE` (`BonusLivesAt`), these make a contiguous 3 byte BCD value
6136   2768             ;* (`$43BD` = low, `$43BE` = middle, `$43BF` = high).
6137   2768             ;* `$43BE` is loaded from the DIP switches to `$30/$40/$50/$60`,
6138   2768             ;* the "extra ship at 3000/4000/5000/6000 points" setting,
6139   2768             ;* and `$43BD`/`$43BF` are its companion digit bytes (zeroed at init).
6140   2768             ;* This 3-byte threshold is checked against the player's score,
6141   2768             ;* using the 3 byte BCD compare `L0314`.
6142   2768             ;*****************************************************************************
6143   2768             L2768:
6144   2768 E5                                 PUSH    HL                  
6145   2769 11 61 42                           LD      DE,$4261            ; end of the screen area of player 1 score
6146   276C 06 06                              LD      B,$06               ; number of digits to print
6147   276E 3A A3 43                           LD      A,(GameAndDemoOrSplash)
6148   2771 A7                                 AND     A                   ; updates the zero flag
6149   2772 CA 78 27                           JP      Z,$2778             ; if GameAndDemoOrSplash is 'Game and demo for player 1'
6150   2775 11 21 40                           LD      DE,$4021            ; end of the screen area of player 2 score
6151   2778 CD C4 00                           CALL    PrintNumber         ; update the score on screen
6152   277B E1                                 POP     HL                  
6153   277C 11 BD 43                           LD      DE,M43BD            ; 
6154   277F EB                                 EX      DE,HL               
6155   2780 7E                                 LD      A,(HL)              
6156   2781 2C                                 INC     L                   
6157   2782 B6                                 OR      (HL)                
6158   2783 C8                                 RET     Z                   
6159   2784 2C                                 INC     L                   
6160   2785 EB                                 EX      DE,HL               
6161   2786 CD 14 03                           CALL    L0314               ; 
6162   2789 D0                                 RET     NC                  
6163   278A 3A A3 43                           LD      A,(GameAndDemoOrSplash)
6164   278D C6 90                              ADD     $90                 
6165   278F 6F                                 LD      L,A                 
6166   2790 34                                 INC     (HL)                
6167   2791 CD 67 03                           CALL    UpdateLivesScreen   ; 
6168   2794 3E FF                              LD      A,$FF               
6169   2796 32 6A 43                           LD      (M436A),A           ; 
6170   2799 2E BE                              LD      L,$BE               
6171   279B 7E                                 LD      A,(HL)              
6172   279C 36 00                              LD      (HL),$00            
6173   279E 0F                                 RRCA                        
6174   279F 0F                                 RRCA                        
6175   27A0 0F                                 RRCA                        
6176   27A1 0F                                 RRCA                        
6177   27A2 2D                                 DEC     L                   
6178   27A3 77                                 LD      (HL),A              
6179   27A4 C9                                 RET                         
6180   27A5             
6181   27A8                                    .ORG $27A8
6182   27A8             ;*****************************************************************************
6183   27A8             ;* Update the sound control hardware registers
6184   27A8             ;*****************************************************************************
6185   27A8             UpdateSoundControlHW:
6186   27A8 21 8C 43                           LD      HL,SoundControlA    ; ..
6187   27AB 7E                                 LD      A,(HL)              ; .. to
6188   27AC 32 00 60                           LD      (SOUNDCTLA),A       ; 60xx sound A
6189   27AF 2C                                 INC     L                   ; SoundControlB ..
6190   27B0 7E                                 LD      A,(HL)              ; .. to
6191   27B1 32 00 68                           LD      (SOUNDCTLB),A       ; 68xx sound B
6192   27B4 F6 0F                              OR      $0F                 ; 0000_1111
6193   27B6 77                                 LD      (HL),A              ;
6194   27B7 2D                                 DEC     L                   ;
6195   27B8 36 0F                              LD      (HL),$0F            ;
6196   27BA C9                                 RET                         ;
6197   27BB             
6198   27BD                                    .ORG $27BD
