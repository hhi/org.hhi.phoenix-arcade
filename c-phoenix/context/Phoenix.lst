1554   054D 06 20                              LD      B,$20               ;
1555   054F CD E0 05                           CALL    CopyBbytesHLtoDE    ;
1556   0552 21 E0 43                           LD      HL,OldPlayerShipMSB ;
1557   0555 06 20                              LD      B,$20               ;
