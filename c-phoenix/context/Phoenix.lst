2071   07AE 23                                 INC     HL                  ;
2072   07AF 5E                                 LD      E,(HL)              ;
2073   07B0 0A                                 LD      A,(BC)              ;
2074   07B1 6F                                 LD      L,A                 ;
2075   07B2 26 14                              LD      H,T1420 >> 8        ; get alien character block shapes table
2076   07B4 7E                                 LD      A,(HL)              ;
