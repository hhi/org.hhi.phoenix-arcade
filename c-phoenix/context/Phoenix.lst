2372   0940 77                                 LD      (HL),A              ;
2373   0941 1A                                 LD      A,(DE)              ;
2374   0942 F6 08                              OR      $08                 ; set bit3 at..
2375   0944 12                                 LD      (DE),A              ; $43C4 PlayerBulletState
2376   0945 13                                 INC     DE                  ;
2377   0946 13                                 INC     DE                  ;
2378   0947 3A C2 43                           LD      A,(PlayerShipX)     ;
2379   094A C6 04                              ADD     $04                 ; mask out 0000_0100
2380   094C 12                                 LD      (DE),A              ;
2381   094D 13                                 INC     DE                  ;
