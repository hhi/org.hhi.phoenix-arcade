8261   39C3             ;*****************************************************************************
8262   39C3             ;* --- Use (the sweep)
8263   39C3             ;* After saving, the routine forces `PlayerBulletState` active (`$39A7: LD (HL),$08`),
8264   39C3             ;* seeds the aim X, and repeatedly calls the bird collision routine `L3800`
8265   39C3             ;* while stepping the "above-player bullet" address down one row at a time — checking up to ~`$1D` rows for a hit.
8266   39C3             ;*****************************************************************************
8267   39C3             L39C3:
8268   39C3 CD 00 38                           CALL    L3800               ; Collision detection for birds
8269   39C6 21 C4 43                           LD      HL,PlayerBulletState
8270   39C9 7E                                 LD      A,(HL)              
8271   39CA E6 08                              AND     $08                 
8272   39CC CA F0 39                           JP      Z,L39F0             ; 
8273   39CF 21 E7 43                           LD      HL,AbovePlayerBulletLSB
8274   39D2 34                                 INC     (HL)                
8275   39D3 7E                                 LD      A,(HL)              
8276   39D4 E6 1F                              AND     $1F                 
8277   39D6 FE 1D                              CP      $1D                 
8278   39D8 DA C3 39                           JP      C,L39C3             ; 
8279   39DB             ;*****************************************************************************
8280   39DB             ;* --- Restore buffer
8281   39DB             ;* When the sweep finishes (or the shield branch at `L39F0` completes),
8282   39DB             ;* the saved bytes are copied back, returning the player bullet to exactly its previous state
8283   39DB             ;*****************************************************************************
8284   39DB             L39DB:
8285   39DB 21 C0 4B                           LD      HL,M4BC0            ; 
8286   39DE 11 C4 43                           LD      DE,PlayerBulletState
8287   39E1 06 04                              LD      B,$04               
8288   39E3 CD E0 05                           CALL    CopyBbytesHLtoDE    ; 
8289   39E6 1E E6                              LD      E,$E6               
8290   39E8 06 02                              LD      B,$02               
8291   39EA C3 E0 05                           JP      CopyBbytesHLtoDE    ; 
8292   39ED             
