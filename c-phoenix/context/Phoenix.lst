8164   3942 3A 9F 43                           LD      A,(M439F)           ; 
8165   3945 82                                 ADD     A,D                 
8166   3946 4F                                 LD      C,A                 
8167   3947 3A 9E 43                           LD      A,(M439E)           ; 
