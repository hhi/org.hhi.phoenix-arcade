2895   0C48 CD 56 0C                           CALL    L0C56               ; Enemy bullets movement and animation
2896   0C4B CD 6B 0C                           CALL    L0C6B               ; Get the screen ram address for all enemy bullets
2897   0C4E CD D8 0C                           CALL    L0CD8               ; Draw or delete the screen objects
2898   0C51 C9                                 RET                         ; 
2899   0C52             
2900   0C56                                    .ORG $0C56
