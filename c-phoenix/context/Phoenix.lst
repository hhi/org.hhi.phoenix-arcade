2157   0800                                    .ORG $0800
2158   0800             ;*****************************************************************************
2159   0800             ;* Game state 3.
2160   0800             ;* Normal game play.
2161   0800             ;*****************************************************************************
2162   0800             L0800:
2163   0800 21 14 08                           LD      HL,T0814            ;
2164   0803 3A B8 43                           LD      A,(LevelAndRound)   ; bit0 - 3: game level, bit4 - 7: game round
2165   0806 07                                 RLCA                        ; Multiply by 2 to get a 2 byte offset
2166   0807 E6 1E                              AND     $1E                 ; mask out 0001_1110 game level
2167   0809 85                                 ADD     A,L                 ; add offset ...
2168   080A 6F                                 LD      L,A                 ; ... to base of table
2169   080B 7E                                 LD      A,(HL)              ; MSB of destination
2170   080C 2C                                 INC     L                   ; Get the
2171   080D 6E                                 LD      L,(HL)              ; ... LSB of destination
2172   080E 67                                 LD      H,A                 ; Now point to function
2173   080F E9                                 JP      (HL)                ; jump to corresponding function according to LevelAndRound.
2174   0810             
2175   0814                                    .ORG $0814
2176   0814             T0814:
2177   0814                                    .MSFIRST
2178   0814 08 34                              .DW L0834       ;Game level 0: called for each frame during stars scrolling down and 'aliens fade in'
2179   0816 20 00                              .DW L2000       ;Game level 1: called for each frame during 'player alife' with aliens, after 'fade in'
2180   0818 08 34                              .DW L0834       ;Game level 2: called for each frame during stars scrolling down and 'aliens fade in'
2181   081A 20 00                              .DW L2000       ;Game level 3: called for each frame during 'player alife' with aliens, after 'fade in'
2182   081C 22 30                              .DW L2230       ;Game level 4: called for each frame during 'spiral fill'
2183   081E 34 00                              .DW L3400       ;Game level 5: called for each frame during birds level including 'fade in'
2184   0820 22 30                              .DW L2230       ;Game level 6: called for each frame during 'spiral fill'
2185   0822 34 00                              .DW L3400       ;Game level 7: called for each frame during birds level including 'fade in'
2186   0824 22 30                              .DW L2230       ;Game level 8: called for each frame during 'spiral fill'
2187   0826 22 B4                              .DW L22B4       ;Game level 9: called for each frame during mothership 'fade in'
2188   0828 22 CA                              .DW L22CA       ;Game level A: called for each frame during mothership and aliens 'fade in'
2189   082A 20 00                              .DW L2000       ;Game level B: called for each frame during 'player alife' with aliens and mothership, after 'fade in'
2190   082C             
2191   0834                                    .ORG $0834
2192   0834             ;*****************************************************************************
2193   0834             ;* Game level 0 and 2:
2194   0834             ;* Stars scrolling down and 'aliens fade in'
2195   0834             ;*****************************************************************************
2196   0834             L0834:
2197   0834 CD F0 06                           CALL    L06F0               ; update scroll register and fill background
2198   0837 21 B4 43                           LD      HL,CounterB4        ; 
2199   083A 35                                 DEC     (HL)                ; decrement the counter
2200   083B 7E                                 LD      A,(HL)              ;
2201   083C FE 15                              CP      $15                 ;
2202   083E D0                                 RET     NC                  ;
2203   083F CD 5A 08                           CALL    GetAnimationChrs    ; for 'aliens fade in'
2204   0842 CD FA 05                           CALL    L05FA               ; init all alien control states
2205   0845 CD 50 0A                           CALL    AlienDataController ;
2206   0848             L0848:
2207   0848 21 B4 43                           LD      HL,CounterB4        ;
2208   084B 7E                                 LD      A,(HL)              ;
2209   084C A7                                 AND     A                   ; updates the zero flag
2210   084D C0                                 RET     NZ                  ; if CounterB4 is 0.
2211   084E 2E B8                              LD      L,$B8               ;
2212   0850 34                                 INC     (HL)                ; increment game level $43B8
2213   0851 2E A4                              LD      L,$A4               ; Next interval game state ...
2214   0853 36 02                              LD      (HL),$02            ; .. is 2
2215   0855 C9                                 RET                         ;
2216   0856             
2217   085A                                    .ORG $085A
2218   085A             ;*****************************************************************************
2219   085A             ;* The 'aliens fade in' animation sequence is:
2220   085A             ;* 6C, 6D, 6E, 6F, 68, from foreground tiles.
2221   085A             ;*****************************************************************************
2222   085A             GetAnimationChrs:
2223   085A 11 6C 08                           LD      DE,$086C            ;
2224   085D FE 11                              CP      $11                 ;
2225   085F D0                                 RET     NC                  ;
2226   0860 1E 6D                              LD      E,$6D               ;
2227   0862 FE 0D                              CP      $0D                 ;
2228   0864 D0                                 RET     NC                  ;
2229   0865 1E 6E                              LD      E,$6E               ;
2230   0867 FE 09                              CP      $09                 ;
2231   0869 D0                                 RET     NC                  ;
2232   086A 1E 6F                              LD      E,$6F               ;
2233   086C FE 05                              CP      $05                 ;
2234   086E D0                                 RET     NC                  ;
2235   086F 1E 68                              LD      E,$68               ;
2236   0871 C9                                 RET                         ;
2237   0872             
2238   0876                                    .ORG $0876
2239   0876             ;*****************************************************************************
2240   0876             ; Updates the player ship, player bullet and the shield.
2241   0876             ;*****************************************************************************
2242   0876             PlayerUpdate:
2243   0876 CD 00 07                           CALL    PlayerDataController     ; draw new / delete old objects
2244   0879 CD 86 08                           CALL    L0886               ; copy current player data to old player data ?
2245   087C CD A0 08                           CALL    L08A0               ; update player position, bullet and shield
2246   087F CD A0 09                           CALL    L09A0               ; get screen ram adress for player ship position
2247   0882 CD 7A 09                           CALL    L097A               ; map player ship position to $439E $439F
