2120   07D6 23                                 INC     HL                  ;
2121   07D7 5E                                 LD      E,(HL)              ; get LSB from player data structure (screen ram)
2122   07D8 0A                                 LD      A,(BC)              ; get value from player data structure (grid)
2123   07D9 6F                                 LD      L,A                 ;
2124   07DA 26 14                              LD      H,T1400 >> 8        ; get player ship character block shapes table
2125   07DC             L07DC:
2126   07DC 7E                                 LD      A,(HL)              ; Entry point for general draw
2127   07DD 12                                 LD      (DE),A              ; draw upper left part
2128   07DE 23                                 INC     HL                  ;
2129   07DF 13                                 INC     DE                  ;
2130   07E0 7E                                 LD      A,(HL)              ;
2131   07E1 12                                 LD      (DE),A              ; draw upper right part
2132   07E2 23                                 INC     HL                  ;
2133   07E3 1B                                 DEC     DE                  ;
2134   07E4 CD 17 02                           CALL    RightOneColumn      ;
2135   07E7 7E                                 LD      A,(HL)              ;
2136   07E8 12                                 LD      (DE),A              ; draw lower left part
2137   07E9 23                                 INC     HL                  ;
2138   07EA 13                                 INC     DE                  ;
2139   07EB 7E                                 LD      A,(HL)              ;
2140   07EC 12                                 LD      (DE),A              ; draw lower right part
2141   07ED 0B                                 DEC     BC                  ;
2142   07EE C9                                 RET                         ;
