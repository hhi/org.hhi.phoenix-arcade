1825   06D0 5E                                 LD      E,(HL)              ;
1826   06D1 79                                 LD      A,C                 ;
1827   06D2 0F                                 RRCA                        ;
1828   06D3 0F                                 RRCA                        ;
1829   06D4 0F                                 RRCA                        ;
1830   06D5 E6 1E                              AND     $1E                 ;
1831   06D7 83                                 ADD     A,E                 ;
