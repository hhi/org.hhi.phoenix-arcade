2970   0CA7 0A                                 LD      A,(BC)              
2971   0CA8 EB                                 EX      DE,HL               
2972   0CA9 2C                                 INC     L                   
2973   0CAA FE E8                              CP      $E8                 
2974   0CAC D2 6E 09                           JP      NC,L096E            ; 
2975   0CAF C9                                 RET                         
