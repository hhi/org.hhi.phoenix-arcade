2086   07BE             ;*****************************************************************************
2087   07BE             ;* Bit4 control function BE:
2088   07BE             ;* If control state A: 1001_xxxx
2089   07BE             ;* Delete 2x2 screen objects (player ship, alien).
2090   07BE             ;*****************************************************************************
2091   07BE             L07BE:
2092   07BE EB                                 EX      DE,HL               ;
2093   07BF 56                                 LD      D,(HL)              ;
2094   07C0 23                                 INC     HL                  ;
2095   07C1 5E                                 LD      E,(HL)              ;
2096   07C2 2B                                 DEC     HL                  ;
2097   07C3 AF                                 XOR     A                   ; A=0
2098   07C4 12                                 LD      (DE),A              ; delete upper left part
2099   07C5 13                                 INC     DE                  ;
2100   07C6 12                                 LD      (DE),A              ; delete upper right part
