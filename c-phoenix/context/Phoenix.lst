0265   0000             
0266   0000             ; Alien data structure (grid).
0267   0000             ; Used for all levels with the 16 aliens.
0268   0000             ; Level: 1, 2, 5 (with mothership), 6, 7, 10(with mothership).
0269   0000             ; During 'fade in' phase, the alien control state B is holding the character code!
0270   0000             M4B70                  .EQU $4B70       ;Alien0 control state A
0271   0000             M4B71                  .EQU $4B71       ;Alien0 control state B (LSB for T14xx)
0272   0000             M4B72                  .EQU $4B72       ;Alien0 screen coordinate X
0273   0000             M4B73                  .EQU $4B73       ;Alien0 screen coordinate Y
0274   0000             M4B74                  .EQU $4B74       ;Alien1 control state A
0275   0000             M4B75                  .EQU $4B75       ;Alien1 control state B (LSB for T14xx)
0276   0000             M4B76                  .EQU $4B76       ;Alien1 screen coordinate X
0277   0000             M4B77                  .EQU $4B77       ;Alien1 screen coordinate Y
0278   0000             M4B78                  .EQU $4B78       ;Alien2 control state A
0279   0000             M4B79                  .EQU $4B79       ;Alien2 control state B (LSB for T14xx)
0280   0000             M4B7A                  .EQU $4B7A       ;Alien2 screen coordinate X
0281   0000             M4B7B                  .EQU $4B7B       ;Alien2 screen coordinate Y
0282   0000             M4B7C                  .EQU $4B7C       ;Alien3 control state A
0283   0000             M4B7D                  .EQU $4B7D       ;Alien3 control state B (LSB for T14xx)
0284   0000             M4B7E                  .EQU $4B7E       ;Alien3 screen coordinate X
0285   0000             M4B7F                  .EQU $4B7F       ;Alien3 screen coordinate Y
