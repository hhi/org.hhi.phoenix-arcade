1888   0720             ;*****************************************************************************
1889   0720             ;* Handles the bit4 actions for deleting screen objects.
1890   0720             ;*****************************************************************************
1891   0720             Bit4Controller:
1892   0720 0A                                 LD      A,(BC)              ; get value from data structure (grid)
1893   0721 67                                 LD      H,A                 ; save the bits
1894   0722 E6 10                              AND     $10                 ; mask out 0001_0000 (bit4 of control state A)
1895   0724 C8                                 RET     Z                   ; ret if bit not set.
1896   0725 7C                                 LD      A,H                 ; restore the bits
1897   0726 E6 EF                              AND     $EF                 ; mask out 1110_1111
1898   0728 02                                 LD      (BC),A              ; save to control state A
1899   0729 07                                 RLCA                        ; Multiply by 8 ..
1900   072A 07                                 RLCA                        ; ..
1901   072B 07                                 RLCA                        ; ..
1902   072C E6 07                              AND     $07                 ; mask out 0000_0111
1903   072E C6 38                              ADD     $38                 ; add to base for jump table
1904   0730 6F                                 LD      L,A                 ;
1905   0731 26 07                              LD      H,T0735 >> 8        ; MSB for jump table
1906   0733 6E                                 LD      L,(HL)              ;
1907   0734 E9                                 JP      (HL)                ; jump to control function
1908   0735             
1909   0735             ; LSB jump table:
1910   0735             ;.....not used
1911   0735             ;........not used
1912   0735             ;...........not used
1913   0735             ;..............0763..................control state A: 0001_xxxx...Delete 1x1 screen objects.
1914   0735             ;.................0779...............control state A: 0011_xxxx...Delete 2x1 screen objects.
1915   0735             ;....................not used
1916   0735             ;.......................079E.........control state A: 0111_xxxx...Delete 1x2 screen objects.
1917   0735             ;..........................07BE......control state A: 1001_xxxx...Delete 2x2 screen objects.
1918   0735             T0735:
1919   0735 00 00 00 63                        .DB $00, $00, $00, L0763 & $FF, L0779 & $FF, $00, L079E & $FF, L07BE & $FF
1919   0739 79 00 9E BE 
1920   073D             
1921   0740                                    .ORG $0740
1922   0740             ;*****************************************************************************
1923   0740             ;* Handles the bit3 actions for drawing screen objects.
1924   0740             ;*****************************************************************************
1925   0740             Bit3Controller:
1926   0740 0A                                 LD      A,(BC)              ; get value from data structure (grid)
1927   0741 67                                 LD      H,A                 ; save it
1928   0742 E6 08                              AND     $08                 ; mask out 0000_1000 (bit3 of control state A)
1929   0744 C8                                 RET     Z                   ; ret if bit not set.
1930   0745 7C                                 LD      A,H                 ; restore the bits
1931   0746 E6 07                              AND     $07                 ; mask out 0000_0111
1932   0748 67                                 LD      H,A                 ; save it
1933   0749 0F                                 RRCA                        ; Divide by 8 ..
1934   074A 0F                                 RRCA                        ; ..
1935   074B 0F                                 RRCA                        ; ..
1936   074C B4                                 OR      H                   ; add original bits
1937   074D F6 18                              OR      $18                 ; set 0001_1000 flag
1938   074F 02                                 LD      (BC),A              ; set the bits at control state A
1939   0750 03                                 INC     BC                  ; go to control state B
1940   0751 7C                                 LD      A,H                 ;
1941   0752 C6 5B                              ADD     $5B                 ; add to base for jump table
1942   0754 6F                                 LD      L,A                 ;
1943   0755 26 07                              LD      H,T0759 >> 8        ; MSB for jump table
1944   0757 6E                                 LD      L,(HL)              ;
1945   0758 E9                                 JP      (HL)                ; jump to control function
1946   0759             
1947   0759             ; LSB jump table:
1948   0759             ;.....not used
1949   0759             ;........not used
1950   0759             ;...........076D.....................control state A: xxxx_1000...Draw 1x1 screen objects.
1951   0759             ;..............0788..................control state A: xxxx_1001...Draw 2x1 screen objects.
1952   0759             ;.................not used
1953   0759             ;....................07AA............control state A: xxxx_1011...Draw 1x2 screen objects.
1954   0759             ;.......................07D2.........control state A: xxxx_1100...Draw 2x2 screen objects.
1955   0759             ;..........................not used
1956   0759             T0759:
1957   0759 00 00 6D 88                        .DB $00, $00, L076D & $FF, L0788 & $FF, $00, L07AA & $FF, L07D2 & $FF
1957   075D 00 AA D2 
1958   0760             
