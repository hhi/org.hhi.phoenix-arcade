1512   050B CD D8 05                           CALL    ClearBbytesAtHL     ;
1513   050E 3A 50 4B                           LD      A,(M4B50)           ;
1514   0511 32 94 43                           LD      (M4394),A           ;
1515   0514 C9                                 RET                         ;
