2289   08C4             MovePlayer:
2290   08C4 21 C0 43                           LD      HL,PlayerState      ;
2291   08C7 7E                                 LD      A,(HL)              ;
2292   08C8 E6 08                              AND     $08                 ; mask out 0000_1000
2293   08CA CA A0 0A                           JP      Z,DrawShields       ; Draw shields
2294   08CD 2E A6                              LD      L,$A6               ;
2295   08CF 7E                                 LD      A,(HL)              ; get ShieldCount
2296   08D0 A7                                 AND     A                   ; updates the zero flag
2297   08D1 C2 EA 08                           JP      NZ,L08EA            ; if ShieldCount not 0.
2298   08D4 06 80                              LD      B,$80               ; 1000_0000 (bit7='shield')
2299   08D6 CD BB 00                           CALL    CheckInputBits      ;
2300   08D9 CA EB 08                           JP      Z,L08EB             ;
2301   08DC 2E 62                              LD      L,$62               ;
2302   08DE 36 40                              LD      (HL),$40            ; set bit6 at $4362
2303   08E0 2E C0                              LD      L,$C0               ;
2304   08E2 7E                                 LD      A,(HL)              ; get $43C0 PlayerState
2305   08E3 E6 F7                              AND     $F7                 ; mask out 1111_0111
2306   08E5 77                                 LD      (HL),A              ;
2307   08E6 2E A6                              LD      L,$A6               ;
2308   08E8 36 FF                              LD      (HL),$FF            ;
2309   08EA             L08EA:
2310   08EA 35                                 DEC     (HL)                ; decrement ShieldCount
2311   08EB             L08EB:
2312   08EB 2E C2                              LD      L,PlayerShipX & $FF ; LSB of $43C2 PlayerShipX
2313   08ED CD 00 09                           CALL    L0900               ; Update the player ship x coordinate.
2314   08F0 01 00 16                           LD      BC,T1600            ;
2315   08F3 C3 26 09                           JP      L0926               ; get player ship animation frame values, mapped with T1600/T1620
2316   08F6             
