2050   07A0 23                                 INC     HL                  ;
2051   07A1 5E                                 LD      E,(HL)              ; get LSB of screen ram
2052   07A2 2B                                 DEC     HL                  ; restore pointer
2053   07A3 AF                                 XOR     A                   ; A=0
2054   07A4 12                                 LD      (DE),A              ; delete at screen, upper part
2055   07A5 13                                 INC     DE                  ;
2056   07A6 12                                 LD      (DE),A              ; delete at screen, lower part
