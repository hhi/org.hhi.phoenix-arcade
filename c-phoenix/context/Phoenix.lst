2016   0788             ;*****************************************************************************
2017   0788             ;* Bit3 control function 88:
2018   0788             ;* If control state A: xxxx_1001
2019   0788             ;* Map alien control state B to shape and draw it.
2020   0788             ;* Draw 2x1 screen objects (alien).
2021   0788             ;*****************************************************************************
2022   0788             L0788:
2023   0788 EB                                 EX      DE,HL               ;
2024   0789 23                                 INC     HL                  ;
2025   078A 23                                 INC     HL                  ;
2026   078B 56                                 LD      D,(HL)              ;
2027   078C 23                                 INC     HL                  ;
2028   078D 5E                                 LD      E,(HL)              ;
2029   078E 0A                                 LD      A,(BC)              ; get alien control state B
2030   078F 6F                                 LD      L,A                 ; as offset for...
2031   0790 26 14                              LD      H,T1420 >> 8        ; get alien character block shapes table
2032   0792 7E                                 LD      A,(HL)              ;
2033   0793 12                                 LD      (DE),A              ; draw alien character left part
2034   0794 23                                 INC     HL                  ; next character
2035   0795 CD 17 02                           CALL    RightOneColumn      ;
2036   0798 7E                                 LD      A,(HL)              ;
2037   0799 12                                 LD      (DE),A              ; draw alien character right part
2038   079A 0B                                 DEC     BC                  ;
2039   079B C9                                 RET                         ;
