1615   05D8             ;*****************************************************************************
1616   05D8             ;* Clears B memories starting at HL.
1617   05D8             ;*****************************************************************************
1618   05D8             ClearBbytesAtHL:
1619   05D8 AF                                 XOR     A                   ; A=0
1620   05D9             L05D9:
1621   05D9 77                                 LD      (HL),A              ; store
1622   05DA 23                                 INC     HL                  ; next
1623   05DB 05                                 DEC     B                   ; decrease counter.
1624   05DC C2 D9 05                           JP      NZ,L05D9            ;
1625   05DF C9                                 RET                         ;
1626   05E0             
1627   05E0             ;*****************************************************************************
1628   05E0             ;* Copy number of bytes (B register) from DE to HL.
1629   05E0             ;*****************************************************************************
1630   05E0             CopyBbytesHLtoDE:
1631   05E0 7E                                 LD      A,(HL)              ; Copy to HL ...
1632   05E1 12                                 LD      (DE),A              ; ... from DE
1633   05E2 23                                 INC     HL                  ; Next destination
1634   05E3 13                                 INC     DE                  ; Next source
1635   05E4 05                                 DEC     B                   ; All done?
1636   05E5 C2 E0 05                           JP      NZ,CopyBbytesHLtoDE ; no ... keep going
1637   05E8 C9                                 RET                         ; Out
1638   05E9             
1639   05EC                                    .ORG $05EC
1640   05EC             ;*****************************************************************************
1641   05EC             ;* Init all alien control states for a given level and round.
1642   05EC             ;*****************************************************************************
1643   05EC             InitAlienControlStates:
1644   05EC 21 00 15                           LD      HL,T1500            ;
1645   05EF 3A B8 43                           LD      A,(LevelAndRound)   ;
1646   05F2 E6 0F                              AND     $0F                 ;
1647   05F4 07                                 RLCA                        ; Multiply by 2
1648   05F5 85                                 ADD     A,L                 ;
1649   05F6 6F                                 LD      L,A                 ;
1650   05F7 56                                 LD      D,(HL)              ;
1651   05F8 23                                 INC     HL                  ;
1652   05F9 5E                                 LD      E,(HL)              ;
1653   05FA             ;
1654   05FA             L05FA:
1655   05FA 21 70 4B                           LD      HL,M4B70            ;
1656   05FD 3A BA 43                           LD      A,(AliensLeft)      ;
1657   0600 47                                 LD      B,A                 ;
1658   0601 A7                                 AND     A                   ; updates the zero flag
1659   0602 C8                                 RET     Z                   ; if no AliensLeft
1660   0603             ;
1661   0603             L0603:
1662   0603 72                                 LD      (HL),D              ; set control state A
1663   0604 2C                                 INC     L                   ;
1664   0605 73                                 LD      (HL),E              ; set control state B
1665   0606 2C                                 INC     L                   ;
1666   0607 2C                                 INC     L                   ;
1667   0608 2C                                 INC     L                   ;
1668   0609 05                                 DEC     B                   ; number of aliens left
1669   060A C2 03 06                           JP      NZ,L0603            ;
1670   060D C9                                 RET                         ;
1671   060E             
1672   0610                                    .ORG $0610
1673   0610             ;*****************************************************************************
1674   0610             ;* Load alien screen coordinates for a given level and round to $4B70 - $4BAF.
1675   0610             ;*****************************************************************************
1676   0610             InitAlienPositions:
1677   0610 21 3A 06                           LD      HL,T063A            ;
1678   0613 3A B8 43                           LD      A,(LevelAndRound)   ;
1679   0616 0F                                 RRCA                        ;
1680   0617 E6 0F                              AND     $0F                 ; mask out 0000_1111
1681   0619 85                                 ADD     A,L                 ;
1682   061A 6F                                 LD      L,A                 ;
1683   061B 00                                 NOP                         ; Old command removed or space for a future replace patch
1684   061C 00                                 NOP                         ; ..
1685   061D 00                                 NOP                         ; ..
1686   061E 6E                                 LD      L,(HL)              ;
1687   061F 26 15                              LD      H,T1540 >> 8        ; MSB for T1540-T15E0
1688   0621 11 72 4B                           LD      DE,M4B72            ;
1689   0624 3A BA 43                           LD      A,(AliensLeft)      ;
1690   0627 47                                 LD      B,A                 ;
1691   0628 A7                                 AND     A                   ; updates the zero flag
1692   0629 C8                                 RET     Z                   ; if no AliensLeft
1693   062A             ;
1694   062A             L062A:
1695   062A 7E                                 LD      A,(HL)              ; get value from table
1696   062B 12                                 LD      (DE),A              ; save to alien screen coordinate
1697   062C 23                                 INC     HL                  ;
1698   062D 13                                 INC     DE                  ;
1699   062E 7E                                 LD      A,(HL)              ;
1700   062F 12                                 LD      (DE),A              ;
1701   0630 23                                 INC     HL                  ;
1702   0631 13                                 INC     DE                  ;
1703   0632 13                                 INC     DE                  ;
1704   0633 13                                 INC     DE                  ;
1705   0634 05                                 DEC     B                   ;
1706   0635 C2 2A 06                           JP      NZ,L062A            ; loop for all AliensLeft
1707   0638 C9                                 RET                         ;
1708   0639             
1709   063A                                    .ORG $063A
1710   063A             ; Init data for 1st game round.
1711   063A             ; LSB's for T1560, T1540, T15E0.
1712   063A             T063A:
1713   063A 60 40 E0 E0                        .DB T1560 & $FF, T1540 & $FF, T15E0 & $FF, T15E0 & $FF, T15E0 & $FF, T15E0 & $FF, $FF, $FF
1713   063E E0 E0 FF FF 
1714   0642             ; Init data for 2nd game round.
1715   0642             ; LSB's for T15C0, T15A0, T1580.
1716   0642 C0 A0 80 80                        .DB T15C0 & $FF, T15A0 & $FF, T1580 & $FF, T1580 & $FF, T1580 & $FF, T1580 & $FF, $FF, $FF
1716   0646 80 80 FF FF 
1717   064A             
1718   0650                                    .ORG $0650
1719   0650             ;*****************************************************************************
1720   0650             ;* Copy init values for 16 aliens to $4B50-$4B6F (Pointer to alien movement pattern)
1721   0650             ;*****************************************************************************
1722   0650             L0650:
1723   0650 21 20 15                           LD      HL,T1520            ;
1724   0653 3A B8 43                           LD      A,(LevelAndRound)   ;
1725   0656 E6 0F                              AND     $0F                 ; mask out 0000_1111
1726   0658 07                                 RLCA                        ; Multiply by 2
1727   0659 85                                 ADD     A,L                 ;
1728   065A 6F                                 LD      L,A                 ;
1729   065B 56                                 LD      D,(HL)              ;
1730   065C 23                                 INC     HL                  ;
1731   065D 5E                                 LD      E,(HL)              ;
1732   065E 21 50 4B                           LD      HL,M4B50            ;
1733   0661 3A BA 43                           LD      A,(AliensLeft)      ;
1734   0664 47                                 LD      B,A                 ;
1735   0665 A7                                 AND     A                   ; updates the zero flag
1736   0666 C8                                 RET     Z                   ; if no AliensLeft
1737   0667             L0667:
1738   0667 72                                 LD      (HL),D              ;
1739   0668 2C                                 INC     L                   ;
1740   0669 73                                 LD      (HL),E              ;
1741   066A 2C                                 INC     L                   ;
1742   066B 05                                 DEC     B                   ;
1743   066C C2 67 06                           JP      NZ,L0667            ; loop for all AliensLeft
1744   066F C9                                 RET                         ;
1745   0670             
1746   067A                                    .ORG $067A
1747   067A             ;*****************************************************************************
1748   067A             ;* Scroll down the background screen one pixel.
1749   067A             ;*****************************************************************************
1750   067A             StarsScrollDown:
1751   067A 21 B9 43                           LD      HL,CounterB9        ;
1752   067D 7E                                 LD      A,(HL)              ;
1753   067E 35                                 DEC     (HL)                ; decrement the backwards counter
1754   067F 32 00 58                           LD      (scrollRegister),A  ; 58xx scroll register
1755   0682 E6 07                              AND     $07                 ; mask out 0000_0111
1756   0684 C0                                 RET     NZ                  ; continue after 8 pixels...
1757   0685             ; Fill the background with stars or mothership.
1758   0685 01 47 20                           LD      BC,$2047            ;
1759   0688 11 21 4B                           LD      DE,$4B21            ; get character from the background screen (1st row, 2nd line)
1760   068B 7E                                 LD      A,(HL)              ; get $43B9 free running 8 bit backwards counter value
1761   068C 0F                                 RRCA                        ;
1762   068D 0F                                 RRCA                        ;
1763   068E 0F                                 RRCA                        ;
1764   068F E6 1F                              AND     $1F                 ; mask out 0001_1111
1765   0691 83                                 ADD     A,E                 ;
1766   0692 5F                                 LD      E,A                 ;
1767   0693 2E B2                              LD      L,$B2               ;
1768   0695 7E                                 LD      A,(HL)              ; get $43B2 (MSB of T1C00 or T1D00 or T1F00)
1769   0696 2C                                 INC     L                   ;
1770   0697 6E                                 LD      L,(HL)              ; get $43B3 (LSB of T1C00 or T1D00 or T1F00)
1771   0698 67                                 LD      H,A                 ;
1772   0699             L0699:
1773   0699 7E                                 LD      A,(HL)              ;
1774   069A 12                                 LD      (DE),A              ; to background screen
1775   069B 2C                                 INC     L                   ;
1776   069C 7B                                 LD      A,E                 ;
1777   069D 90                                 SUB     B                   ;
1778   069E 5F                                 LD      E,A                 ;
1779   069F D2 99 06                           JP      NC,L0699            ;
1780   06A2 15                                 DEC     D                   ;
1781   06A3 7A                                 LD      A,D                 ;
1782   06A4 B9                                 CP      C                   ;
1783   06A5 C2 99 06                           JP      NZ,L0699            ;
1784   06A8 7D                                 LD      A,L                 ;
1785   06A9 32 B3 43                           LD      (M43B3),A           ;
1786   06AC C9                                 RET                         ;
1787   06AD             
1788   06B0                                    .ORG $06B0
1789   06B0             ;*****************************************************************************
1790   06B0             ;* Fill the background with (2x2) planets.
1791   06B0             ;* Reads the MSB from `T1E20`, then reaches `T1E40` simply by adding `$20`
1792   06B0             ;* to the same pointer (`$1E20 + $20 = $1E40`) — which is the clearest proof that `T1E40` is the LSB companion of `T1E20`.
1793   06B0             ;* So `DE = (T1E20[i] << 8) | T1E40[i]`, then the LSB gets a scroll dependent offset added (derived from `CounterB9 >> 3`)
1794   06B0             ;* so the planet drifts down as the star background scrolls. `DE` ends up somewhere in `$4800`–`$4BFF` (the background screen).
1795   06B0             ;* The graphic itself is then chosen via `T1E60 -> T1E00` and drawn by `L07DC`.
1796   06B0             ;* The routine only fires when `CounterB9` matches the planet counter (`$43AB`),
1797   06B0             ;* so as the background scrolls a new planet is dropped in at successive slots,
1798   06B0             ;* the slot index (masked to `$1F`) cycles through all 32 `T1E20`/`T1E40` positions.
1799   06B0             ;*****************************************************************************
1800   06B0             AddPlanetsToBackground:
1801   06B0 21 AB 43                           LD      HL,M43AB            ; counter value for (2x2) planets
1802   06B3 3A B9 43                           LD      A,(CounterB9)       ;
1803   06B6 4F                                 LD      C,A                 ;
1804   06B7 BE                                 CP      (HL)                ;
1805   06B8 C0                                 RET     NZ                  ;
1806   06B9 7E                                 LD      A,(HL)              ;
1807   06BA 2C                                 INC     L                   ;
1808   06BB 86                                 ADD     A,(HL)              ;
