6448   3000             
6449   3000             ;*****************************************************************************
6450   3000             ; h7-ic51.7a
6451   3000             ;*****************************************************************************
6452   3000             
6453   3000             ;*****************************************************************************
6454   3000             ;* AlienBehaviorUpdate.
6455   3000             ;* This is the 'core of the matter'!
6456   3000             ;* The 'core of the matter': drives every alien attack pattern and the
6457   3000             ;* randomized selection. One sub-task runs per frame, chosen round-robin by
6458   3000             ;* Counter93 (0-7) via jump table T3018. The sub-tasks cooperate through the
6459   3000             ;* behavior state machine at $4350 and the control block $4350-$435B.
6460   3000             ;* The selected patterns do always fit on the screen,
6461   3000             ;* even if the alien formation is further down. (phase 1, 2, 3)
6462   3000             ;*****************************************************************************
6463   3000             L3000:
6464   3000 21 93 43                           LD      HL,Counter93        ; 
6465   3003 7E                                 LD      A,(HL)              ; load and save ram value
6466   3004 34                                 INC     (HL)                ; increment Counter93
6467   3005 E6 07                              AND     $07                 ; masc out 0000_0111 the saved value in order to count from 0 to 7
6468   3007 21 18 30                           LD      HL,T3018            ; base of jump table
6469   300A 07                                 RLCA                        ; Multiply by 2 to get a 2 byte offset
6470   300B 85                                 ADD     A,L                 ;
6471   300C 6F                                 LD      L,A                 ;
6472   300D 7E                                 LD      A,(HL)              ; get MSB from jump table
6473   300E 23                                 INC     HL                  ;
6474   300F 6E                                 LD      L,(HL)              ; get LSB from jump table
6475   3010 67                                 LD      H,A                 ;
6476   3011 E9                                 JP      (HL)                ; jump to the corresponding function
6477   3012             ;*****************************************************************************
6478   3012             ;* Sub-task 7: Do nothing.
6479   3012             ;*****************************************************************************
6480   3012             L3012:
6481   3012 C9                                 RET                         ;
6482   3013             
6483   3018                                    .ORG $3018
6484   3018             ;
6485   3018             T3018:
6486   3018                                    .MSFIRST
6487   3018 32 64                              .DW L3264 ; 0 -> L3264  install chosen pattern / rotate start pointer
6488   301A 30 28                              .DW L3028 ; 1 -> L3028  'Angry movement A/B' (push formation down)
6489   301C 30 BA                              .DW L30BA ; 2 -> L30BA  tick attack-delay + group timers
6490   301E 31 24                              .DW L3124 ; 3 -> L3124  decide how many aliens attack
6491   3020 31 5A                              .DW L315A ; 4 -> L315A  pick a random alien to attack
6492   3022 31 B4                              .DW L31B4 ; 5 -> L31B4  choose the closed-loop swoop pattern
6493   3024 32 2C                              .DW L322C ; 6 -> L322C  confirm pattern start across the grid
6494   3026 30 12                              .DW L3012 ; 7 -> L3012  (nop)
6495   3028             
6496   3028             ;*****************************************************************************
6497   3028             ;* Sub-task 1: 'Angry movement pattern A/B' (pattern 26/28).
6498   3028             ;* Every $4358 frames, escalate $4357 and re-arm the downward-push pattern
6499   3028             ;* (T2E00/T2E40), so the formation creeps further down the screen.
6500   3028             ;*****************************************************************************
6501   3028             L3028:
6502   3028 21 57 43                           LD      HL,M4357            ; 
6503   302B 7E                                 LD      A,(HL)              
6504   302C FE 03                              CP      $03                 
6505   302E D0                                 RET     NC                  ; if >= 3
6506   302F 2E 50                              LD      L,$50               
6507   3031 7E                                 LD      A,(HL)              ; get $4350
6508   3032 FE 04                              CP      $04                 
6509   3034 D0                                 RET     NC                  ; if >= 4
6510   3035 2E 58                              LD      L,$58               
6511   3037 7E                                 LD      A,(HL)              ; get $4358
6512   3038 A7                                 AND     A                   ; updates the zero flag
6513   3039 CA 5C 30                           JP      Z,L305C             ; 
6514   303C 35                                 DEC     (HL)                ; $4358
6515   303D C0                                 RET     NZ                  
6516   303E 2D                                 DEC     L                   
6517   303F 34                                 INC     (HL)                ; $4357
6518   3040 2E 50                              LD      L,$50               
6519   3042 36 04                              LD      (HL),$04            ; set $4350
6520   3044 2E 53                              LD      L,$53               
6521   3046 36 10                              LD      (HL),$10            ; set $4353
6522   3048 2C                                 INC     L                   
6523   3049 36 50                              LD      (HL),$50            ; set $4354
6524   304B 2E 51                              LD      L,$51               
6525   304D 36 2E                              LD      (HL),$2E            ; set $4351
6526   304F 2C                                 INC     L                   
6527   3050 36 00                              LD      (HL),$00            ; clear $4352
6528   3052 3A C2 43                           LD      A,(PlayerShipX)     ; 
6529   3055 0F                                 RRCA                        
6530   3056 D8                                 RET     C                   
6531   3057 36 40                              LD      (HL),$40            ; set $4352
6532   3059 C9                                 RET                         
6533   305A             
6534   305C                                    .ORG $305C
6535   305C             ;*****************************************************************************
6536   305C             ;* End of movement pattern reached. Get the next start pointer.
6537   305C             ;*****************************************************************************
6538   305C             L305C:
6539   305C CD 74 30                           CALL    L3074               ; 
6540   305F 21 57 43                           LD      HL,M4357            ; 
6541   3062 7E                                 LD      A,(HL)              ; get $4357
6542   3063 07                                 RLCA                        ; Multiply by 4 ..
6543   3064 07                                 RLCA                        ; ..
6544   3065 00                                 NOP                         ;
6545   3066 00                                 NOP                         ;
6546   3067 81                                 ADD     A,C                 ;
6547   3068 C6 07                              ADD     $07                 ;
6548   306A 2E 58                              LD      L,$58               ;
6549   306C 77                                 LD      (HL),A              ; store to $4358
6550   306D C9                                 RET                         ;
6551   306E             
6552   3074                                    .ORG $3074
6553   3074             ;*****************************************************************************
6554   3074             ;* Build a scaled random magnitude in C from round, level, aliens-left and
6555   3074             ;* a random number. Used to size timer spans and attacker counts.
6556   3074             ;*****************************************************************************
6557   3074             L3074:
6558   3074 21 B8 43                           LD      HL,LevelAndRound    ; 
6559   3077 7E                                 LD      A,(HL)              
6560   3078 0F                                 RRCA                        
6561   3079 00                                 NOP                         
6562   307A E6 07                              AND     $07                 ; 0000_0111
6563   307C 47                                 LD      B,A                 
6564   307D 3E 07                              LD      A,$07               
6565   307F 90                                 SUB     B                   
6566   3080 4F                                 LD      C,A                 
6567   3081 7E                                 LD      A,(HL)              ; get LevelAndRound
6568   3082 FE 80                              CP      $80                 
6569   3084 DA 89 30                           JP      C,L3089             ; 
6570   3087 3E 70                              LD      A,$70               
6571   3089             L3089:
6572   3089 0F                                 RRCA                        
6573   308A 0F                                 RRCA                        
6574   308B 0F                                 RRCA                        
6575   308C 0F                                 RRCA                        
6576   308D E6 07                              AND     $07                 
6577   308F 47                                 LD      B,A                 
6578   3090 3E 07                              LD      A,$07               
6579   3092 90                                 SUB     B                   
6580   3093 81                                 ADD     A,C                 
6581   3094 4F                                 LD      C,A                 
6582   3095 3A BA 43                           LD      A,(AliensLeft)      ; 
6583   3098 D6 05                              SUB     $05                 
6584   309A D2 9F 30                           JP      NC,L309F            ; 
6585   309D 3E 10                              LD      A,$10               
6586   309F             L309F:
6587   309F 81                                 ADD     A,C                 
6588   30A0 4F                                 LD      C,A                 
6589   30A1 CD AA 30                           CALL    GetRandomNumber     ; 
6590   30A4 E6 07                              AND     $07                 
6591   30A6 81                                 ADD     A,C                 
6592   30A7 4F                                 LD      C,A                 
6593   30A8 C9                                 RET                         
6594   30A9             
6595   30AA                                    .ORG $30AA
6596   30AA             ;*****************************************************************************
6597   30AA             ;* Free running counter ($439B) and the X position of the player ship ($43C2)
6598   30AA             ;* is the base for a pseudo random number.
6599   30AA             ;* Returns A-register: $00 to $0F.
6600   30AA             ;*****************************************************************************
6601   30AA             GetRandomNumber:
6602   30AA 21 9B 43                           LD      HL,Counter9A+$1     ; 
6603   30AD 7E                                 LD      A,(HL)              ;
6604   30AE 07                                 RLCA                        ; Multiply by 8 ..
6605   30AF 07                                 RLCA                        ; ..
6606   30B0 07                                 RLCA                        ; ..
6607   30B1 E6 07                              AND     $07                 ; mask out 0000_0111 in order to count from 0 to 7
6608   30B3 2E C2                              LD      L,$C2               ; get $43C2 PlayerShipX
6609   30B5 86                                 ADD     A,(HL)              ; add to counter value
6610   30B6 E6 0F                              AND     $0F                 ; mask out 0000_1111
6611   30B8 C9                                 RET                         ;
6612   30B9             
6613   30BA                                    .ORG $30BA
6614   30BA             ;*****************************************************************************
6615   30BA             ;* Sub-task 2: tick the three staggered group timers and the attack delay.
6616   30BA             ;* When the delay $4355 expires (in state 0) begin a new attack (state 1).
6617   30BA             ;*****************************************************************************
6618   30BA             L30BA:
6619   30BA 21 58 43                           LD      HL,M4358            ; 
6620   30BD CD DA 30                           CALL    L30DA               ; for $4359
6621   30C0 CD DA 30                           CALL    L30DA               ; for $435A
6622   30C3 CD DA 30                           CALL    L30DA               ; for $435B
6623   30C6 2E 50                              LD      L,$50               
6624   30C8 7E                                 LD      A,(HL)              ; get $4350
6625   30C9 A7                                 AND     A                   ; updates the zero flag
6626   30CA C0                                 RET     NZ                  ; if <> 0
6627   30CB 2E 55                              LD      L,$55               
6628   30CD 7E                                 LD      A,(HL)              ; get $4355
6629   30CE A7                                 AND     A                   ; updates the zero flag
6630   30CF CA E4 30                           JP      Z,L30E4             ; if 0
6631   30D2 35                                 DEC     (HL)                
6632   30D3 C0                                 RET     NZ                  
6633   30D4 2E 50                              LD      L,$50               
6634   30D6 36 01                              LD      (HL),$01            
6635   30D8 C9                                 RET                         
6636   30D9             
6637   30DA                                    .ORG $30DA
6638   30DA             ;*****************************************************************************
6639   30DA             ;* Tick one timer (does not go below 0).
6640   30DA             ;*****************************************************************************
6641   30DA             L30DA:
6642   30DA 2C                                 INC     L                   
6643   30DB 7E                                 LD      A,(HL)              
6644   30DC A7                                 AND     A                   ; updates the zero flag
6645   30DD C8                                 RET     Z                   ; if 4359, 435A, 435B = 0
6646   30DE 35                                 DEC     (HL)                
6647   30DF C9                                 RET                         
6648   30E0             
6649   30E4                                    .ORG $30E4
6650   30E4             ;*****************************************************************************
6651   30E4             ;* Recompute the attack delay $4355 and reload the 3 group timers.
6652   30E4             ;*****************************************************************************
6653   30E4             L30E4:
6654   30E4 CD 74 30                           CALL    L3074               ; 
6655   30E7 21 9A 43                           LD      HL,Counter9A        ; 
6656   30EA 7E                                 LD      A,(HL)              
6657   30EB FE 10                              CP      $10                 
6658   30ED DA F2 30                           JP      C,L30F2             ; 
6659   30F0 3E 0F                              LD      A,$0F               
6660   30F2             L30F2:
6661   30F2 47                                 LD      B,A                 
6662   30F3 3E 0F                              LD      A,$0F               
6663   30F5 90                                 SUB     B                   
6664   30F6 81                                 ADD     A,C                 
6665   30F7 4F                                 LD      C,A                 
6666   30F8 06 01                              LD      B,$01               
6667   30FA 2E 58                              LD      L,$58               
6668   30FC CD 12 31                           CALL    L3112               ; for $4359
6669   30FF CD 12 31                           CALL    L3112               ; for $435A
6670   3102 CD 12 31                           CALL    L3112               ; for $435B
6671   3105 79                                 LD      A,C                 
6672   3106 0F                                 RRCA                        
6673   3107 0F                                 RRCA                        
6674   3108 E6 3F                              AND     $3F                 ; 0011_1111
6675   310A C6 01                              ADD     $01                 
6676   310C 2E 55                              LD      L,$55               
6677   310E 77                                 LD      (HL),A              ; set $4355
6678   310F C9                                 RET                         
6679   3110             
6680   3112                                    .ORG $3112
6681   3112             ;*****************************************************************************
6682   3112             ;* Reload one group timer (only if it is currently 0).
6683   3112             ;*****************************************************************************
6684   3112             L3112:
6685   3112 2C                                 INC     L                   
6686   3113 7E                                 LD      A,(HL)              
6687   3114 A7                                 AND     A                   ; updates the zero flag
6688   3115 C0                                 RET     NZ                  ; if <> 0
6689   3116 79                                 LD      A,C                 
6690   3117 0F                                 RRCA                        
6691   3118 E6 7F                              AND     $7F                 ; 0111_1111
6692   311A 4F                                 LD      C,A                 
6693   311B 78                                 LD      A,B                 
6694   311C A7                                 AND     A                   ; updates the zero flag
6695   311D C8                                 RET     Z                   
6696   311E 05                                 DEC     B                   
6697   311F 36 0C                              LD      (HL),$0C            
6698   3121 C9                                 RET                         
6699   3122             
6700   3124                                    .ORG $3124
6701   3124             ;*****************************************************************************
6702   3124             ;* Sub-task 3: in state 1, advance to state 2 and compute the number of
6703   3124             ;* aliens that will fly the swoop ($4353), from round + random, reduced as
6704   3124             ;* the escalation counter $4357 grows.
6705   3124             ;*****************************************************************************
6706   3124             L3124:
6707   3124 21 50 43                           LD      HL,M4350            ; 
6708   3127 7E                                 LD      A,(HL)              
6709   3128 FE 01                              CP      $01                 
6710   312A C0                                 RET     NZ                  ; if <> 1
6711   312B 36 02                              LD      (HL),$02            ; set $4350
6712   312D 2E B8                              LD      L,$B8               
6713   312F 7E                                 LD      A,(HL)              ; get LevelAndRound
6714   3130 0F                                 RRCA                        
6715   3131 0F                                 RRCA                        
6716   3132 E6 0F                              AND     $0F                 
6717   3134 C6 05                              ADD     $05                 
6718   3136 FE 11                              CP      $11                 
6719   3138 DA 3D 31                           JP      C,L313D             ; 
6720   313B 3E 05                              LD      A,$05               
6721   313D             L313D:
6722   313D 2E 57                              LD      L,$57               
6723   313F 96                                 SUB     (HL)                
6724   3140 47                                 LD      B,A                 
6725   3141 CD AA 30                           CALL    GetRandomNumber     ; 
6726   3144 3C                                 INC     A                   
6727   3145 B8                                 CP      B                   
6728   3146 DA 4B 31                           JP      C,L314B             ; 
6729   3149 3E 01                              LD      A,$01               
6730   314B             L314B:
6731   314B 2E 53                              LD      L,$53               
6732   314D 77                                 LD      (HL),A              
6733   314E C9                                 RET                         
6734   314F             
6735   315A                                    .ORG $315A
6736   315A             ;*****************************************************************************
6737   315A             ;* Sub-task 4: in state 2, scan the 16-alien grid from a random offset for
6738   315A             ;* an active alien whose control bytes match the current start pointer.
6739   315A             ;* The first match is recorded in $4354 and state advances to 3.
6740   315A             ;*****************************************************************************
6741   315A             L315A:
6742   315A 21 50 43                           LD      HL,M4350            ; 
6743   315D 7E                                 LD      A,(HL)              
6744   315E FE 02                              CP      $02                 
6745   3160 C0                                 RET     NZ                  ; if <> 2
6746   3161 CD AA 30                           CALL    GetRandomNumber     ; 
6747   3164 00                                 NOP                         
6748   3165 47                                 LD      B,A                 
6749   3166 07                                 RLCA                        ; Multiply by 2
6750   3167 C6 50                              ADD     $50                 
6751   3169 6F                                 LD      L,A                 
6752   316A 26 4B                              LD      H,$4B               
6753   316C 78                                 LD      A,B                 
6754   316D 07                                 RLCA                        ; Multiply by 4 ..
6755   316E 07                                 RLCA                        ;
6756   316F C6 70                              ADD     $70                 
6757   3171 5F                                 LD      E,A                 
6758   3172 16 4B                              LD      D,$4B               
6759   3174 0E 10                              LD      C,$10               
6760   3176 79                                 LD      A,C                 
6761   3177 90                                 SUB     B                   
6762   3178 47                                 LD      B,A                 
6763   3179             L3179:
6764   3179 CD 92 31                           CALL    L3192               ; 
6765   317C 13                                 INC     DE                  
6766   317D 13                                 INC     DE                  
6767   317E 13                                 INC     DE                  
6768   317F 13                                 INC     DE                  
6769   3180 23                                 INC     HL                  
6770   3181 23                                 INC     HL                  
6771   3182 05                                 DEC     B                   
6772   3183 C2 8A 31                           JP      NZ,L318A            ; 
6773   3186 1E 70                              LD      E,$70               
6774   3188 2E 50                              LD      L,$50               
6775   318A             L318A:
6776   318A 0D                                 DEC     C                   
6777   318B C2 79 31                           JP      NZ,L3179            ; 
6778   318E C9                                 RET                         
6779   318F             
6780   3192                                    .ORG $3192
