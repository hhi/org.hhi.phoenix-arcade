2733   0B4E 36 0C                              LD      (HL),$0C            
2734   0B50 2C                                 INC     L                   
2735   0B51 36 0C                              LD      (HL),$0C            
2736   0B53 2C                                 INC     L                   
2737   0B54 7E                                 LD      A,(HL)              
2738   0B55 E6 F8                              AND     $F8                 
2739   0B57 F6 03                              OR      $03                 
2740   0B59 77                                 LD      (HL),A              
2741   0B5A C9                                 RET                         
