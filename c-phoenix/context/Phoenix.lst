3589   0FC0             ;*****************************************************************************
3590   0FC0             ;* Handle animations for killed aliens.
3591   0FC0             ;* Services 4 explosion slots (4-byte records at $4370/$4374/$4378/$437C):
3592   0FC0             ;*   +0 = animation counter (0 = slot free)
3593   0FC0             ;*   +1 = unused
3594   0FC0             ;*   +2 = screen-RAM MSB
3595   0FC0             ;*   +3 = screen-RAM LSB
3596   0FC0             ;* Slots 0/1 are ordinary alien explosions (L0FD8); slots 2/3 use L3758
3597   0FC0             ;* (the bonus-explosion animator).
3598   0FC0             ;*****************************************************************************
3599   0FC0             L0FC0:
3600   0FC0 21 70 43                           LD      HL,M4370            ; explosion slot 0
3601   0FC3 CD D8 0F                           CALL    L0FD8               ; advance alien explosion
3602   0FC6 21 74 43                           LD      HL,M4374            ; explosion slot 1
3603   0FC9 CD D8 0F                           CALL    L0FD8               ; advance alien explosion
3604   0FCC 21 78 43                           LD      HL,M4378            ; slot 2 (bonus explosion counter)
3605   0FCF CD 58 37                           CALL    L3758               ; advance bonus explosion
3606   0FD2 21 7C 43                           LD      HL,M437C            ; slot 3 (bonus explosion)
3607   0FD5 C3 58 37                           JP      L3758               ; advance bonus explosion (tail-call)
3608   0FD8             ;*****************************************************************************
3609   0FD8             ;* Advance and draw one alien-explosion slot.
3610   0FD8             ;* HL -> slot record (+0 = counter). Returns immediately if the slot is idle.
3611   0FD8             ;*****************************************************************************
3612   0FD8             L0FD8:
3613   0FD8 7E                                 LD      A,(HL)              
3614   0FD9 A7                                 AND     A                   ; updates the zero flag
3615   0FDA C8                                 RET     Z                   
3616   0FDB 46                                 LD      B,(HL)              
3617   0FDC 35                                 DEC     (HL)                
3618   0FDD 2C                                 INC     L                   
3619   0FDE 2C                                 INC     L                   
3620   0FDF 56                                 LD      D,(HL)              
3621   0FE0 2C                                 INC     L                   
3622   0FE1 5E                                 LD      E,(HL)              
3623   0FE2 00                                 NOP                         
3624   0FE3 CD 10 02                           CALL    LeftOneColumn       ; 
3625   0FE6 78                                 LD      A,B                 
3626   0FE7 E6 0E                              AND     $0E                 
3627   0FE9 0F                                 RRCA                        
3628   0FEA C6 B0                              ADD     $B0                 
3629   0FEC 6F                                 LD      L,A                 
