8476   3AD0             ;*****************************************************************************
8477   3AD0             ;* Background sound for the bird waves:
8478   3AD0             ;* Counts frames for the current tone;
8479   3AD0             ;* it's compared against a per-phase duration taken from `T3DE0`
8480   3AD0             ;* (indexed by the formation scroll phase `B4BD6`),
8481   3AD0             ;* and when the duration is reached it resets to 0, which advances `$438E` to the next note.
8482   3AD0             ;*****************************************************************************
8483   3AD0             L3AD0:
8484   3AD0 21 8E 43                           LD      HL,M438E            ; Bird-wave background-sound phase
8485   3AD3 7E                                 LD      A,(HL)              ; 
8486   3AD4 E6 01                              AND     $01                 ; 0000_0001 phase bit
8487   3AD6 07                                 RLCA                        ; Multiply by 4 ..
8488   3AD7 07                                 RLCA                        ; ..
8489   3AD8 F6 20                              OR      $20                 ; 0010_0000
8490   3ADA 47                                 LD      B,A                 ; 
8491   3ADB 2D                                 DEC     L                   ; 
8492   3ADC 7E                                 LD      A,(HL)              ; $438D SoundControlB
8493   3ADD E6 C0                              AND     $C0                 ; 1100_0000
8494   3ADF B0                                 OR      B                   ; set bits
8495   3AE0 77                                 LD      (HL),A              ; at SoundControlB
8496   3AE1 2E 96                              LD      L,$96               ; $4396 bird-wave background-sound step timer
8497   3AE3 7E                                 LD      A,(HL)              ; 
8498   3AE4 34                                 INC     (HL)                ; 
8499   3AE5 A7                                 AND     A                   ; updates the zero flag
8500   3AE6 CA F8 3A                           JP      Z,L3AF8             ; 
8501   3AE9 3A D6 4B                           LD      A,(M4BD6)           ; 
8502   3AEC C6 E0                              ADD     $E0                 ; LSB of table T3DE0 Background sound data for the bird waves.
8503   3AEE 5F                                 LD      E,A                 ; 
