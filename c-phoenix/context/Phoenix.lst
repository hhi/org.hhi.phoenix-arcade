4695   2000             
4696   2000             ;*****************************************************************************
4697   2000             ; h5-ic49.5a
4698   2000             ;*****************************************************************************
4699   2000             ;*****************************************************************************
4700   2000             ;* Game level 1, 3 and B:
4701   2000             ;* 'player alife' with aliens, after 'fade in'
4702   2000             ;*****************************************************************************
4703   2000             L2000:
4704   2000 CD 76 08                           CALL    PlayerUpdate        ; Updates the player ship, player bullet and the shield.
4705   2003 CD F0 0D                           CALL    L0DF0               ; alien bullet to player, collission detection ?
4706   2006 CD A0 24                           CALL    L24A0               ; 
4707   2009 21 5F 43                           LD      HL,M435F            ; 8 bit counter for alien movement
4708   200C 7E                                 LD      A,(HL)              ; get value
4709   200D E6 03                              AND     $03                 ; mask out 0000_0011 for count 0 to 3
4710   200F 47                                 LD      B,A                 ; save the masked counter
4711   2010 34                                 INC     (HL)                ; increment alien movement counter
4712   2011 3A BA 43                           LD      A,(AliensLeft)      ; 
4713   2014 A7                                 AND     A                   ; updates the zero flag
4714   2015 CA BA 21                           JP      Z,L21BA             ; if no AliensLeft
4715   2018 FE 05                              CP      $05                 ;
4716   201A D2 30 21                           JP      NC,L2130            ; if <= 5 left
4717   201D 2D                                 DEC     L                   ; $435E
4718   201E 78                                 LD      A,B                 ; get masked counter
4719   201F A7                                 AND     A                   ; updates the zero flag
4720   2020 C2 25 20                           JP      NZ,L2025            ; if masked counter <> 0
4721   2023 36 FF                              LD      (HL),$FF            ; set all bits at $435E
4722   2025             L2025:
4723   2025 7E                                 LD      A,(HL)              ; get $435E
4724   2026 A7                                 AND     A                   ; updates the zero flag
4725   2027 CA 30 21                           JP      Z,L2130             ; if $435E = 0
4726   202A C3 46 21                           JP      L2146               ; 
4727   202D             
4728   2030                                    .ORG $2030
4729   2030             ;
4730   2030             L2030:
4731   2030 E6 03                              AND     $03                 
4732   2032 FE 01                              CP      $01                 
4733   2034 11 50 1B                           LD      DE,$1B50            
4734   2037 C3 AC 23                           JP      L23AC               ; 
4735   203A             
4736   2040                                    .ORG $2040
4737   2040             ;*****************************************************************************
4738   2040             ;* Add 1x1 small galaxies to background.
4739   2040             ;*****************************************************************************
4740   2040             AddGalaxiesToBackground:
4741   2040 21 AF 43                           LD      HL,M43AF            ; 
4742   2043 3A B9 43                           LD      A,(CounterB9)       ; 
4743   2046 4F                                 LD      C,A                 ;
4744   2047 BE                                 CP      (HL)                ;
4745   2048 C0                                 RET     NZ                  ;
4746   2049 7E                                 LD      A,(HL)              ;
4747   204A 2C                                 INC     L                   ;
4748   204B 96                                 SUB     (HL)                ;
4749   204C 2D                                 DEC     L                   ;
4750   204D 77                                 LD      (HL),A              ;
4751   204E 2C                                 INC     L                   ;
4752   204F 2C                                 INC     L                   ;
4753   2050 34                                 INC     (HL)                ;
4754   2051 7E                                 LD      A,(HL)              ;
4755   2052 21 80 1E                           LD      HL,T1E80            ; data for the 16 (1x1) small galaxies from setB
4756   2055 E6 1F                              AND     $1F                 ;
4757   2057 85                                 ADD     A,L                 ;
4758   2058 6F                                 LD      L,A                 ;
4759   2059 46                                 LD      B,(HL)              ;
4760   205A C6 20                              ADD     $20                 ;
4761   205C 6F                                 LD      L,A                 ;
4762   205D 56                                 LD      D,(HL)              ;
4763   205E C6 20                              ADD     $20                 ;
4764   2060 6F                                 LD      L,A                 ;
4765   2061 5E                                 LD      E,(HL)              ;
4766   2062 79                                 LD      A,C                 ;
4767   2063 0F                                 RRCA                        ;
4768   2064 0F                                 RRCA                        ;
4769   2065 0F                                 RRCA                        ;
4770   2066 E6 1F                              AND     $1F                 ;
4771   2068 83                                 ADD     A,E                 ;
4772   2069 3C                                 INC     A                   ;
4773   206A 5F                                 LD      E,A                 ;
4774   206B 78                                 LD      A,B                 ;
4775   206C 12                                 LD      (DE),A              ;
4776   206D C9                                 RET                         ;
4777   206E             
4778   2070                                    .ORG $2070
4779   2070             ;*****************************************************************************
4780   2070             ;* `L2070`/`L2085` compute the entry offset from the ship position and current phase,
4781   2070             ;* so as `CounterA5` counts down the "lit" cells sweep through the field.
4782   2070             ;* The ship visibly bursts into scattering particles that then thin out and vanish.
4783   2070             ;*****************************************************************************
4784   2070             L2070:
4785   2070 7B                                 LD      A,E                 
4786   2071 D6 0A                              SUB     $0A                 
4787   2073 C6 C0                              ADD     $C0                 
4788   2075 4F                                 LD      C,A                 
4789   2076 7A                                 LD      A,D                 
4790   2077 CE 00                              ADC     $00                 
4791   2079 47                                 LD      B,A                 
4792   207A 7E                                 LD      A,(HL)              
4793   207B 11 00 28                           LD      DE,T2800            ; get the foreground tiles of the player ship particles explosion
4794   207E 21 00 29                           LD      HL,T2900            ; and get the control data for it
4795   2081 C3 85 20                           JP      L2085               ; 
4796   2084             
4797   2085                                    .ORG $2085
4798   2085             ;
4799   2085             L2085:
4800   2085 D6 20                              SUB     $20                 
4801   2087 07                                 RLCA                        ; Multiply by 4 ..
4802   2088 07                                 RLCA                        ; ..
4803   2089 00                                 NOP                         
4804   208A E6 E0                              AND     $E0                 
4805   208C 6F                                 LD      L,A                 
4806   208D 3E E0                              LD      A,$E0               
4807   208F 95                                 SUB     L                   
4808   2090 6F                                 LD      L,A                 
4809   2091             L2091:
4810   2091 3E 3F                              LD      A,$3F               
4811   2093 91                                 SUB     C                   
4812   2094 3E 43                              LD      A,$43               
4813   2096 98                                 SBC     B                   
4814   2097 D2 B0 20                           JP      NC,L20B0            ; 
4815   209A 23                                 INC     HL                  
4816   209B 23                                 INC     HL                  
4817   209C 7B                                 LD      A,E                 
4818   209D C6 10                              ADD     $10                 
4819   209F 5F                                 LD      E,A                 
4820   20A0 79                                 LD      A,C                 
4821   20A1 D6 20                              SUB     $20                 
4822   20A3 4F                                 LD      C,A                 
4823   20A4 78                                 LD      A,B                 
4824   20A5 DE 00                              SBC     $00                 
4825   20A7 47                                 LD      B,A                 
4826   20A8 C3 91 20                           JP      L2091               ; 
4827   20AB             
4828   20B0                                    .ORG $20B0
4829   20B0             ;*****************************************************************************
4830   20B0             ;* Player ship particles explosion.
4831   20B0             ;*****************************************************************************
4832   20B0             L20B0:
4833   20B0 C5                                 PUSH    BC                  
4834   20B1             L20B1:
4835   20B1 7E                                 LD      A,(HL)              
4836   20B2 E3                                 EX      (SP),HL             
4837   20B3 06 08                              LD      B,$08               
4838   20B5             L20B5:
4839   20B5 36 00                              LD      (HL),$00            
4840   20B7 0F                                 RRCA                        
4841   20B8 D2 BF 20                           JP      NC,L20BF            ; 
4842   20BB EB                                 EX      DE,HL               
4843   20BC 4E                                 LD      C,(HL)              
4844   20BD EB                                 EX      DE,HL               ; get data from $2800
4845   20BE 71                                 LD      (HL),C              
4846   20BF             L20BF:
4847   20BF 23                                 INC     HL                  
4848   20C0 13                                 INC     DE                  
4849   20C1 05                                 DEC     B                   
4850   20C2 C2 B5 20                           JP      NZ,L20B5            ; 
4851   20C5 E3                                 EX      (SP),HL             
4852   20C6 23                                 INC     HL                  
4853   20C7 7D                                 LD      A,L                 
4854   20C8 0F                                 RRCA                        
4855   20C9 DA B1 20                           JP      C,L20B1             ; 
4856   20CC 7D                                 LD      A,L                 
4857   20CD E6 1F                              AND     $1F                 
4858   20CF CA E1 20                           JP      Z,L20E1             ; 
4859   20D2 E3                                 EX      (SP),HL             
4860   20D3 7D                                 LD      A,L                 
4861   20D4 D6 30                              SUB     $30                 
4862   20D6 6F                                 LD      L,A                 
4863   20D7 7C                                 LD      A,H                 
4864   20D8 DE 00                              SBC     $00                 
4865   20DA 67                                 LD      H,A                 
4866   20DB E3                                 EX      (SP),HL             
4867   20DC FE 3F                              CP      $3F                 
4868   20DE C2 B1 20                           JP      NZ,L20B1            ; 
4869   20E1             L20E1:
4870   20E1 C1                                 POP     BC                  
4871   20E2 C9                                 RET                         
4872   20E3             
4873   20E8                                    .ORG $20E8
4874   20E8             ;*****************************************************************************
4875   20E8             ;* Draw one 4x4 ship-fragment sprite during the player-ship explosion.
4876   20E8             ;* Entry (from L0BC4): A = CounterA5 phase, DE = ship screen address.
4877   20E8             ;* Fragment image pointer comes from T1B90; position is scattered using
4878   20E8             ;* CounterB9 (via L211C) and the phase.
4879   20E8             ;* Purpose:
4880   20E8             ;* `L20E8` draws the flying debris sprites of the exploding player ship
4881   20E8             ;* (fragment image chosen from `T1B90`, scattered by `CounterB9`/phase,
4882   20E8             ;* `L211C` freezing the scroll).
4883   20E8             ;*****************************************************************************
4884   20E8             L20E8:
4885   20E8 47                                 LD      B,A                 ; B = phase (CounterA5)
4886   20E9 7A                                 LD      A,D                 ; 
4887   20EA C6 08                              ADD     $08                 ; nudge the row
4888   20EC 57                                 LD      D,A                 ; 
4889   20ED CD 1C 21                           CALL    L211C               ; {code.L211C} clamp scroll during explosion
4890   20F0 0F                                 RRCA                        ; 
4891   20F1 0F                                 RRCA                        ; scatter offset from CounterB9
4892   20F2 0F                                 RRCA                        ; 
4893   20F3 83                                 ADD     A,E                 ; 
4894   20F4 E6 1F                              AND     $1F                 ; 0001_1111 keep within a column
4895   20F6 4F                                 LD      C,A                 ; 
4896   20F7 7B                                 LD      A,E                 ; 
4897   20F8 E6 E0                              AND     $E0                 ; 1110_0000 column bits
4898   20FA B1                                 OR      C                   ; 
4899   20FB 5F                                 LD      E,A                 ; E = scattered LSB
4900   20FC 78                                 LD      A,B                 ; phase
4901   20FD 0F                                 RRCA                        ; 
4902   20FE 0F                                 RRCA                        ; 
4903   20FF E6 0E                              AND     $0E                 ; 0000_1110 -> even index 0..14
4904   2101 C6 90                              ADD     $90                 ; -> T1B90 entry
4905   2103 6F                                 LD      L,A                 ; 
4906   2104 26 1B                              LD      H,$1B               ; HL = T1B90 + index
4907   2106 7E                                 LD      A,(HL)              ; fragment image MSB
4908   2107 2C                                 INC     L                   ; 
4909   2108 6E                                 LD      L,(HL)              ; fragment image LSB
4910   2109 67                                 LD      H,A                 ; HL = fragment image
4911   210A 01 04 04                           LD      BC,$0404            ; images are 4x4images are 4x4
4912   210D C3 D6 0A                           JP      DrawImageCbyB       ; draw it
4913   2110             
4914   211C                                    .ORG $211C
4915   211C             ;*****************************************************************************
4916   211C             ;* Clamp the scroll register to $10 while CounterB9 is in ($10,$30).
4917   211C             ;*****************************************************************************
4918   211C             L211C:
4919   211C 21 B9 43                           LD      HL,CounterB9        ; 
4920   211F 7E                                 LD      A,(HL)              
4921   2120 FE 10                              CP      $10                 
4922   2122 D8                                 RET     C                   
4923   2123 FE 30                              CP      $30                 
4924   2125 D0                                 RET     NC                  
4925   2126 3E 10                              LD      A,$10               
4926   2128 77                                 LD      (HL),A              
4927   2129 32 00 58                           LD      (scrollRegister),A  ; 58xx scroll register
4928   212C C9                                 RET                         
4929   212D             
4930   2130                                    .ORG $2130
4931   2130             ;*****************************************************************************
4932   2130             ;* Per-frame update dispatchers for the alien-wave levels.
4933   2130             ;* B = frame phase (rotating counter). Each phase runs a different subset of
4934   2130             ;* the heavy per-frame work, spreading it across frames.
4935   2130             ;* `L2130`/`L2146`/`L21BA` are the game's per frame level dispatchers:
4936   2130             ;* A rotating frame phase counter (`B`) selects one of several groups of update calls
4937   2130             ;* (`AlienDataController`, `AlienBehaviorUpdate`, `AlienMovementUpdate`,
4938   2130             ;* `AlienAnimationUpdate`, `EnemyBulletUpdate`, collision `L0F00`, killed alien anim `L0FC0`,
4939   2130             ;* bomb drop `L2560`, mothership housekeeping `L24C4`),
4940   2130             ;* so the heavy work is spread over multiple frames.
4941   2130             ;*****************************************************************************
4942   2130             L2130:
4943   2130 78                                 LD      A,B                 ; frame phase
4944   2131 A7                                 AND     A                   ; updates the zero flag
4945   2132 CA 50 21                           JP      Z,L2150             ; phase 0
4946   2135 FE 01                              CP      $01                 ;
4947   2137 CA 60 21                           JP      Z,L2160             ; phase 1
4948   213A FE 02                              CP      $02                 ;
4949   213C CA 70 21                           JP      Z,L2170             ; phase 2
4950   213F C3 80 21                           JP      L2180               ; phase 3
4951   2142             
4952   2146                                    .ORG $2146
4953   2146             ;*****************************************************************************
4954   2146             ;* Game's per frame level dispatcher (even/odd phase)
4955   2146             ;*****************************************************************************
4956   2146             L2146:
4957   2146 78                                 LD      A,B                 ; 
4958   2147 0F                                 RRCA                        ; test phase bit 0
4959   2148 D2 90 21                           JP      NC,L2190            ; even phase
4960   214B C3 A5 21                           JP      L21A5               ; odd phase
4961   214E             
4962   2150                                    .ORG $2150
4963   2150             ;*****************************************************************************
4964   2150             ;* Phase 0
4965   2150             ;*****************************************************************************
4966   2150             L2150:
4967   2150 CD 50 0A                           CALL    AlienDataController ; draw or delete alien
4968   2153 CD 00 30                           CALL    L3000               ; AlienBehaviorUpdate
4969   2156 C3 00 0F                           JP      L0F00               ; 'alien with player' collision check
4970   2159             
4971   2160                                    .ORG $2160
4972   2160             ;*****************************************************************************
4973   2160             ;* Phase 1
4974   2160             ;*****************************************************************************
4975   2160             L2160:
4976   2160 CD C4 24                           CALL    L24C4               ; background / mothership housekeeping
4977   2163 CD 40 0C                           CALL    L0C40               ; EnemyBulletUpdate
4978   2166 CD 1C 0D                           CALL    L0D1C               ; AlienMovementUpdate
4979   2169 C3 C0 0F                           JP      L0FC0               ; Handle animations for killed aliens
4980   216C             
4981   2170                                    .ORG $2170
4982   2170             ;*****************************************************************************
4983   2170             ;* Phase 2
4984   2170             ;*****************************************************************************
4985   2170             L2170:
4986   2170 CD 70 0D                           CALL    L0D70               ; AlienAnimationUpdate
4987   2173 C3 60 25                           JP      L2560               ; try to drop a bomb on the player
4988   2176             
4989   2180                                    .ORG $2180
4990   2180             ;*****************************************************************************
4991   2180             ;* Phase 3
4992   2180             ;*****************************************************************************
4993   2180             L2180:
4994   2180 CD C4 24                           CALL    L24C4               ; background / mothership housekeeping
4995   2183 CD 40 0C                           CALL    L0C40               ; EnemyBulletUpdate
4996   2186 CD 6C 0A                           CALL    L0A6C               ; get screen ram adress for all aliens
4997   2189 C3 C0 0F                           JP      L0FC0               ; Handle animations for killed aliens
4998   218C             
4999   2190                                    .ORG $2190
5000   2190             ;
5001   2190             L2190:
5002   2190 CD 50 0A                           CALL    AlienDataController ; draw or delete alien
5003   2193 CD 00 30                           CALL    L3000               ; AlienBehaviorUpdate
5004   2196 CD 00 0F                           CALL    L0F00               ; 'alien with player' collision check
5005   2199 CD 60 25                           CALL    L2560               ; try to drop a bomb
5006   219C C3 40 0C                           JP      L0C40               ; EnemyBulletUpdate
5007   219F             
5008   21A5                                    .ORG $21A5
5009   21A5             ;
5010   21A5             L21A5:
5011   21A5 CD 1C 0D                           CALL    L0D1C               ; AlienMovementUpdate
5012   21A8 CD 70 0D                           CALL    L0D70               ; AlienAnimationUpdate
5013   21AB CD 6C 0A                           CALL    L0A6C               ; get screen ram adress for all aliens
5014   21AE CD C0 0F                           CALL    L0FC0               ; Handle animations for killed aliens
5015   21B1 C3 C4 24                           JP      L24C4               ; background / mothership housekeeping
5016   21B4             
5017   21BA                                    .ORG $21BA
5018   21BA             ;*****************************************************************************
5019   21BA             ;* Mothership-wave dispatcher (and end-of-wave handling).
5020   21BA             ;*****************************************************************************
5021   21BA             L21BA:
5022   21BA 78                                 LD      A,B                 ;
5023   21BB 0F                                 RRCA                        ; test phase bit 0
5024   21BC D2 04 22                           JP      NC,L2204            ; even phase: end-of-wave countdown (L2204)
5025   21BF CD 40 0C                           CALL    L0C40               ; EnemyBulletUpdate
5026   21C2 CD C0 0F                           CALL    L0FC0               ; Handle animations for killed aliens
5027   21C5 CD C4 24                           CALL    L24C4               ; mothership housekeeping
5028   21C8 3A B8 43                           LD      A,(LevelAndRound)   ; 
5029   21CB E6 0F                              AND     $0F                 ; mask out 0000_1111
5030   21CD FE 0B                              CP      $0B                 ;
5031   21CF DA 04 22                           JP      C,L2204             ; if < game level B
5032   21D2 3E 10                              LD      A,$10               ; 16 aliens for a new wave
5033   21D4 32 BA 43                           LD      (AliensLeft),A      ; 
5034   21D7 C3 26 05                           JP      L0526               ; init alien data
5035   21DA             
5036   21DC                                    .ORG $21DC
5037   21DC             ;*****************************************************************************
5038   21DC             ;* Handles the bird animation at intro.
5039   21DC             ;* The driver is a single counter, `M4399` 
5040   21DC             ;* (the "slow-print" timer that advances during the intro splash).
5041   21DC             ;* Its bits are split into two roles:
5042   21DC             ;* - `M4399 & 7` -> the bird's animation sub-phase 
5043   21DC             ;*   (written to bird-object byte +3, `$4B73`).
5044   21DC             ;*   This cycles the wing position 0–7 within the current shape.
5045   21DC             ;* - `M4399 >> 3` -> the index into `T233A`, which yields the shape index 
5046   21DC             ;*   (written to bird-object byte +0, `$4B70`).
5047   21DC             ;* In other words, each entry in `T233A` is held for 8 timer ticks
5048   21DC             ;* (one full pass of the low-3-bit phase) before the script advances to the next shape.
5049   21DC             ;* `T233A` is therefore "the shape every 8 frames", and the low bits provide the in-between wing flapping.
5050   21DC             ;*****************************************************************************
5051   21DC             DrawIntroBirdAnimationFrame:
5052   21DC 7E                                 LD      A,(HL)              ; {ram.M4399} Actual index for slow print at intro splash (starts with $300)
5053   21DD 00                                 NOP                         ;
5054   21DE 47                                 LD      B,A                 ; save it
5055   21DF 21 73 4B                           LD      HL,B4B73            ; used as temp memory
5056   21E2 E6 07                              AND     $07                 ; mask out 0000_0111 in order to count from 0 to 7
5057   21E4 77                                 LD      (HL),A              ; save it
5058   21E5 2D                                 DEC     L                   ;
5059   21E6 36 EF                              LD      (HL),$EF            ; use $4B72 for LSB of screen ram
5060   21E8 2D                                 DEC     L                   ;
5061   21E9 36 49                              LD      (HL),$49            ; use $4B71 for MSB of screen ram
5062   21EB 2D                                 DEC     L                   ; $4B70 (bird0 index character block shape)
5063   21EC 78                                 LD      A,B                 ; restore $4399
5064   21ED E6 F8                              AND     $F8                 ; mask out 1111_1000
5065   21EF 0F                                 RRCA                        ; Divide by 8 ..
5066   21F0 0F                                 RRCA                        ; ..
5067   21F1 0F                                 RRCA                        ; ..
5068   21F2 C6 3A                              ADD     T233A & $FF         ; LSB of T233A
5069   21F4 5F                                 LD      E,A                 ;
5070   21F5 16 23                              LD      D,T233A >> 8        ; MSB of T233A
5071   21F7 1A                                 LD      A,(DE)              ; get data starting at T233A for animation frame index
5072   21F8 77                                 LD      (HL),A              ; write to $4B70
5073   21F9 CD C0 34                           CALL    DrawBirdObject      ; draw the bird at intro
5074   21FC C3 E0 1E                           JP      L1EE0               ; 
5075   21FF             
5076   2204                                    .ORG $2204
5077   2204             ;
5078   2204             L2204:
5079   2204 21 B6 43                           LD      HL,M43B6            ; End-of-wave countdown timer
5080   2207 35                                 DEC     (HL)                ;
5081   2208 7E                                 LD      A,(HL)              ;
5082   2209 FE A0                              CP      $A0                 ;
5083   220B D0                                 RET     NC                  ;
5084   220C 2E A4                              LD      L,$A4               ;
5085   220E 36 02                              LD      (HL),$02            ; set GameState to: 'initialization of game and level data'
5086   2210 2E A6                              LD      L,$A6               ;
5087   2212 36 00                              LD      (HL),$00            ; clear ShieldCount
5088   2214 2E B8                              LD      L,$B8               ;
5089   2216 34                                 INC     (HL)                ; increment LevelAndRound
5090   2217 7E                                 LD      A,(HL)              ;
5091   2218 E6 0E                              AND     $0E                 ; mask out 0000_1110
5092   221A 0F                                 RRCA                        ; divide by 2
5093   221B C6 60                              ADD     T1760 & $FF         ; add to base of table T1760
5094   221D 5F                                 LD      E,A                 ;
5095   221E 16 17                              LD      D,T1760 >> 8        ;
5096   2220 2C                                 INC     L                   ;
5097   2221 2C                                 INC     L                   ;
5098   2222 1A                                 LD      A,(DE)              ; get value from table T1760
5099   2223 A7                                 AND     A                   ; updates the flags
5100   2224 F2 2A 22                           JP      P,L222A             ; if not positive.
5101   2227 2C                                 INC     L                   ; use BirdsLeft
5102   2228 E6 7F                              AND     $7F                 ; mask out 0111_1111
5103   222A             L222A:
5104   222A 77                                 LD      (HL),A              ; save to $43BA (AliensLeft) or $43BB (BirdsLeft)
5105   222B C3 80 03                           JP      ClearForeground     ; 
5106   222E             
5107   2230                                    .ORG $2230
5108   2230             ;*****************************************************************************
5109   2230             ;* Game level 4, 6 and 8:
5110   2230             ;* Drives the spiral fade-in animation between waves.
5111   2230             ;* The animation step counter is incremented every frame,
5112   2230             ;* its value indexes the spiral drawing progress,
5113   2230             ;* and when the spiral is complete it advances to the next level.
5114   2230             ;*****************************************************************************
5115   2230             L2230:
5116   2230 21 9C 43                           LD      HL,M439C            ; 
5117   2233 7E                                 LD      A,(HL)              ;
5118   2234 34                                 INC     (HL)                ; advance animation
5119   2235 00                                 NOP                         ;
5120   2236 0F                                 RRCA                        ;
5121   2237 E6 3F                              AND     $3F                 ; mask out 0011_1111
5122   2239 FE 0D                              CP      $0D                 ;
5123   223B CA 92 22                           JP      Z,L2292             ; 
5124   223E 06 1F                              LD      B,$1F               ; The asterisk character
5125   2240 DA 60 22                           JP      C,L2260             ; 
5126   2243 06 00                              LD      B,$00               ; The space character
5127   2245 D6 0E                              SUB     $0E                 ;
5128   2247 FE 0D                              CP      $0D                 ;
5129   2249 C2 60 22                           JP      NZ,L2260            ; 
5130   224C 21 B8 43                           LD      HL,LevelAndRound    ; 
5131   224F 34                                 INC     (HL)                ; increment game level $43B8
5132   2250 2E A4                              LD      L,$A4               ; HL=43A4 -- game state
5133   2252 36 02                              LD      (HL),$02            ; Next interval game state is 2: 'init game and level data'
5134   2254 C9                                 RET                         ;
5135   2255             
5136   2260                                    .ORG $2260
5137   2260             ;
5138   2260             L2260:
5139   2260 4F                                 LD      C,A                 ;
5140   2261 0F                                 RRCA                        ;
5141   2262 0F                                 RRCA                        ;
5142   2263 0F                                 RRCA                        ;
5143   2264 57                                 LD      D,A                 ;
5144   2265 E6 1F                              AND     $1F                 ;
5145   2267 5F                                 LD      E,A                 ;
5146   2268 7A                                 LD      A,D                 ;
5147   2269 E6 E0                              AND     $E0                 ;
5148   226B C6 B0                              ADD     $B0                 ;
5149   226D 6F                                 LD      L,A                 ;
5150   226E 7B                                 LD      A,E                 ;
5151   226F CE 41                              ADC     $41                 ;
5152   2271 67                                 LD      H,A                 ;
5153   2272 7D                                 LD      A,L                 ;
5154   2273 91                                 SUB     C                   ;
5155   2274 6F                                 LD      L,A                 ;
5156   2275 79                                 LD      A,C                 ;
5157   2276 3C                                 INC     A                   ;
5158   2277 4F                                 LD      C,A                 ;
5159   2278 07                                 RLCA                        ; Multiply by 2
5160   2279 5F                                 LD      E,A                 ;
5161   227A             ;
5162   227A             L227A:
5163   227A 51                                 LD      D,C                 ; D is the height counter for each pass
5164   227B             ;
5165   227B             L227B:
5166   227B 70                                 LD      (HL),B              ; draw the asterisk or space
5167   227C 23                                 INC     HL                  ; one row down
5168   227D 70                                 LD      (HL),B              ; another asterisk or space
5169   227E 23                                 INC     HL                  ; one row down
5170   227F 15                                 DEC     D                   ; all of this column done?
5171   2280 C2 7B 22                           JP      NZ,L227B            ; No ... do all rows
5172   2283 7D                                 LD      A,L                 ; LSB of screen pointer
5173   2284 91                                 SUB     C                   ; move up ...
5174   2285 91                                 SUB     C                   ; ... height * 2
5175   2286 D6 20                              SUB     $20                 ; Move right one column
5176   2288 6F                                 LD      L,A                 ; New LSB
5177   2289 7C                                 LD      A,H                 ; Borrow into ...
5178   228A DE 00                              SBC     $00                 ; ... the ...
5179   228C 67                                 LD      H,A                 ; ... MSB
5180   228D 1D                                 DEC     E                   ; All columns done?
5181   228E C2 7A 22                           JP      NZ,L227A            ; no ... do all columns
5182   2291 C9                                 RET                         ; Done
